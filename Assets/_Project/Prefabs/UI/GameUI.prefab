  m_text: "\u041F\u0430\u0440\u0430 \u043C\u0438\u043D\u0443\u0442 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438:
    \u0431\u0435\u0433, \u0431\u0440\u043E\u0441\u043E\u043A, \u043B\u043E\u0432\u043B\u044F,
    \u0440\u044B\u0432\u043E\u043A, \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0438
    \u0438 \u043B\u0430\u0440\u0451\u043A. \u041F\u0440\u043E\u0439\u0442\u0438 \u0435\u0451
    \u043C\u043E\u0436\u043D\u043E \u0438 \u043F\u043E\u0442\u043E\u043C: \xAB\u0422\u0435\u0442\u0440\u0430\u0434\u043A\u0430\xBB
    \u2192 \xAB\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C\xBB."
