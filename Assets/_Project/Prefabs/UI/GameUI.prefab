  m_text: "WASD \u2014 \u0431\u0435\u0433    \u043C\u044B\u0448\u044C \u2014 \u043F\u0440\u0438\u0446\u0435\u043B   
    \u041B\u041A\u041C \u2014 \u0431\u0440\u043E\u0441\u043E\u043A (\u0434\u0435\u0440\u0436\u0438
    \u2014 \u0437\u0430\u0440\u044F\u0434)\n\u041F\u041A\u041C / E \u2014 \u043B\u043E\u0432\u043B\u044F   
    Space / Shift \u2014 \u0440\u044B\u0432\u043E\u043A    Esc \u2014 \u043F\u0430\u0443\u0437\u0430\n\u0413\u0435\u0439\u043C\u043F\u0430\u0434:
    \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A, \u043F\u0440\u0430\u0432\u044B\u0439
    \u0441\u0442\u0438\u043A, RT \u2014 \u0431\u0440\u043E\u0441\u043E\u043A, LT
    \u2014 \u043B\u043E\u0432\u043B\u044F, A \u2014 \u0440\u044B\u0432\u043E\u043A\nH
    \u2014 \u0441\u043A\u0440\u044B\u0442\u044C \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443   
    F1 \u2014 \u043E\u0442\u043B\u0430\u0434\u043A\u0430"
