%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Content_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9709e1cdb23fa419990d29f684126c4e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 153544024064
    m_Localized: Big Roly-Poly
    m_Metadata:
      m_Items: []
  - m_Id: 153552412672
    m_Localized: Medicine Ball
    m_Metadata:
      m_Items: []
  - m_Id: 153552412673
    m_Localized: 'Heavy: hits everyone nearby. Only 2 balls.'
    m_Metadata:
      m_Items: []
  - m_Id: 153552412674
    m_Localized: Tennis Balls
    m_Metadata:
      m_Items: []
  - m_Id: 153552412675
    m_Localized: 5 balls. Hold throw to fire a burst.
    m_Metadata:
      m_Items: []
  - m_Id: 153552412676
    m_Localized: Volleyball
    m_Metadata:
      m_Items: []
  - m_Id: 153552412677
    m_Localized: After a hit it hops to 2 more enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 153552412678
    m_Localized: Boomerang
    m_Metadata:
      m_Items: []
  - m_Id: 153552412679
    m_Localized: The ball flies back to you, hitting everyone.
    m_Metadata:
      m_Items: []
  - m_Id: 153552412680
    m_Localized: On a String
    m_Metadata:
      m_Items: []
  - m_Id: 153552412681
    m_Localized: A dropped ball jumps back into your hands.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606976
    m_Localized: One More Ball
    m_Metadata:
      m_Items: []
  - m_Id: 153556606977
    m_Localized: +1 ball in your hands.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606978
    m_Localized: Split
    m_Metadata:
      m_Items: []
  - m_Id: 153556606979
    m_Localized: On a hit the ball splits in two.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606980
    m_Localized: Sticky Hands
    m_Metadata:
      m_Items: []
  - m_Id: 153556606981
    m_Localized: Catching is easier.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606982
    m_Localized: Long Arms
    m_Metadata:
      m_Items: []
  - m_Id: 153556606983
    m_Localized: Pick up balls and coins from farther away.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606984
    m_Localized: New Sneakers
    m_Metadata:
      m_Items: []
  - m_Id: 153556606985
    m_Localized: Run 10% faster.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606986
    m_Localized: Sandwich
    m_Metadata:
      m_Items: []
  - m_Id: 153556606987
    m_Localized: +1 heart. From grandma.
    m_Metadata:
      m_Items: []
  - m_Id: 23928708784128
    m_Localized: Bouncy Ball
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978432
    m_Localized: The ball bounces off the ground and hits again.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978433
    m_Localized: Hot Potato
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978434
    m_Localized: Catch a ball and your next throw explodes.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978435
    m_Localized: Bubble Gum
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978436
    m_Localized: The ball leaves a sticky trail. Enemies get stuck.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978437
    m_Localized: Slide Tackle
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978438
    m_Localized: Your dash knocks enemies down.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978439
    m_Localized: Hooligan
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978440
    m_Localized: Throws hit 1 harder, but you get fewer balls.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978441
    m_Localized: Freeze!
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978442
    m_Localized: "Perfect catch \u2014 enemies around you freeze."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509120
    m_Localized: Off the Wall
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509121
    m_Localized: 'Each wall bounce: +1 damage.'
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509122
    m_Localized: Slingshot
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509123
    m_Localized: A charged throw goes through enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509124
    m_Localized: Eagle Eye
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509125
    m_Localized: The ball curves into the nearest enemy.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509126
    m_Localized: Domino
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509127
    m_Localized: A knocked-out enemy falls on its neighbours.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509128
    m_Localized: Piggy Bank
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509129
    m_Localized: 'At the kiosk: +1 coin for every 10.'
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509130
    m_Localized: Pot Lid
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509131
    m_Localized: Blocks one ball every 20 s.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509132
    m_Localized: Around the World
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509133
    m_Localized: A ball on a string circles around you.
    m_Metadata:
      m_Items: []
  - m_Id: 194562260721664
    m_Localized: Jump Rope
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915968
    m_Localized: Dash farther and more often.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915975
    m_Localized: Second Wind
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915976
    m_Localized: 'Once per run: knocked out? Get back up.'
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915977
    m_Localized: Grandma's Pies
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915978
    m_Localized: +1 heart.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915981
    m_Localized: Firecracker
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915982
    m_Localized: "Catch a ball \u2014 your next one explodes on every bounce."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915983
    m_Localized: Hail
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915984
    m_Localized: Every burst ball splits twice.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915985
    m_Localized: Kettlebell
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915986
    m_Localized: The area hit stuns everyone.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915987
    m_Localized: Leapfrog
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915988
    m_Localized: Dash into an enemy to leap over it.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915991
    m_Localized: Lucky Wrapper
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915992
    m_Localized: Pick from 4 cards instead of 3.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915993
    m_Localized: PE Teacher Mannequin
    m_Metadata:
      m_Items: []
  - m_Id: 377579491024896
    m_Localized: The One in the Dusk
    m_Metadata:
      m_Items: []
  - m_Id: 441337332621312
    m_Localized: Brainiac
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204224
    m_Localized: Loves books, a bit of a know-it-all
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204225
    m_Localized: Chubs
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204226
    m_Localized: Kind, always hungry, your best friend
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204227
    m_Localized: Shorty
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204228
    m_Localized: Fast, fearless, never sits still
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204229
    m_Localized: Hooligan
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204230
    m_Localized: Tough scrapper, boss of the yard
    m_Metadata:
      m_Items: []
  - m_Id: 1280561648754688
    m_Localized: Kiosk Transformer
    m_Metadata:
      m_Items: []
  - m_Id: 1280561657143296
    m_Localized: Big Plush Bunny
    m_Metadata:
      m_Items: []
  - m_Id: 1455588239204352
    m_Localized: Roly-Poly
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398656
    m_Localized: Waddles toward you and body-slams. A hit knocks it over; it rocks
      and gets back up on its own.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398657
    m_Localized: "One hit does it. When they bunch up, hit the outermost one \u2014
      a falling roly-poly knocks over its neighbours."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398658
    m_Localized: Baby Doll
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398659
    m_Localized: Runs in a swarm, shoving its neighbours; up close it crouches and
      leaps to bite.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398660
    m_Localized: "Goes down in one hit, and the ball passes right through \u2014
      throw along the swarm."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398661
    m_Localized: Tin Soldier
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398662
    m_Localized: 'Marches in formation: the line stops at range, winds up together
      and throws in turn. Sometimes throws a spiky hedgehog.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398663
    m_Localized: "Catch his balls \u2014 they are your main supply of balls and hearts.
      Don't catch a hedgehog (red and glowing) \u2014 dodge it."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398664
    m_Localized: Teddy Bear
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398665
    m_Localized: "A slow tank that plows ahead and swipes with its paw up close.
      Balls get stuck in its belly \u2014 one ball fewer for you."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398666
    m_Localized: Another hit knocks the stuck ball onto the floor, and a knocked-out
      bear drops them all. Stay out of paw reach.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398667
    m_Localized: Wind-up Chick
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398668
    m_Localized: Winds up (the key spins and sparks), runs straight to where you
      stood and explodes. The blast hits everyone around, enemies too.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398669
    m_Localized: "Step aside while it winds up. Hit by a ball, it blows up on the
      spot \u2014 detonate it in a crowd."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398670
    m_Localized: Spinning Top
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398671
    m_Localized: Spins and rolls toward you in an arc, knocking you over on contact.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398672
    m_Localized: "A hit sends it flying like a billiard ball \u2014 aim so it ploughs
      into other enemies."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398673
    m_Localized: Rocking Horse
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398674
    m_Localized: Rocks harder and harder, then charges in a straight line.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398675
    m_Localized: "A hit while it rocks breaks the charge. After a charge it rocks
      in place \u2014 that's your window."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398676
    m_Localized: Pot-Lid Soldier
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398677
    m_Localized: 'Advances holding a pot lid in front of him: balls bounce off it
      like off a wall. Up close he swings a ladle.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398678
    m_Localized: Hit him from the side, from behind, off a ricochet or with a boomerang.
      A charged ball knocks the lid away for a couple of seconds.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398679
    m_Localized: Pioneer Drummer
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398680
    m_Localized: 'Doesn''t attack himself: hangs back and beats his drum. His drumbeat
      makes nearby enemies run faster.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398681
    m_Localized: Take him out first. A hit throws off his rhythm and the drum goes
      quiet.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398682
    m_Localized: Wind-up Frog
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398683
    m_Localized: Leaps at you in an arc; the landing hits a circle that shows on
      the ground beforehand.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398684
    m_Localized: "A ball mid-jump flips her on her back. When she runs down she sits
      and rewinds \u2014 a window for throws."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398685
    m_Localized: RC Car
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398686
    m_Localized: Zooms around in circles, revs in place, then rams in a straight
      line and skids out.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398687
    m_Localized: "A ball flips it wheels-up \u2014 helpless for a couple of seconds.
      When its wheels spin, get off its line."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398688
    m_Localized: Dendy Light Gun
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398689
    m_Localized: 'Hops on its grip and keeps its distance, then aims a laser: the
      beam and a line on the ground track you and freeze right before the shot.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398690
    m_Localized: "The shot can't be caught \u2014 it's light. When the line freezes,
      step off it. A hit spoils its aim."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398691
    m_Localized: Mannequin
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398692
    m_Localized: Freezes while you look at it, striking a new pose each time. Look
      away and it sneaks up fast and strikes.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398693
    m_Localized: 'Keep it in front of you and keep hitting: you can always hit it,
      and your gaze stops even its swing.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398694
    m_Localized: Scarecrow
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398695
    m_Localized: Hops on its pole and keeps its distance. Its arms catch balls from
      the front and throw them back a second later.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398696
    m_Localized: "Hit it from the side or back \u2014 it turns slowly. A charged
      ball breaks through its arms, and you can catch its return throw."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398697
    m_Localized: Shadow
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398698
    m_Localized: Comes out of the dark and drifts toward you. In the dark balls pass
      right through it; under a lamp it's solid.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398699
    m_Localized: "Stand under a lamp so it has to step into the light. It turns solid
      anywhere as it winds up, and a \xABSmena\xBB camera flash burns it."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398700
    m_Localized: Music-Box Ballerina
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398701
    m_Localized: 'Spins on her stand and glides toward you: a ball thrown into her
      pirouette circles her and flies back at you.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398702
    m_Localized: Hit her after the pirouette while she curtsies. A charged ball breaks
      through the pirouette, and you can catch a deflected one.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398703
    m_Localized: Lunokhod
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398704
    m_Localized: Crawls along on eight wheels, keeping its distance. Raises its solar-panel
      lid and fires a fan of spiky hedgehogs.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398705
    m_Localized: "Hedgehogs can't be caught \u2014 dodge them. With the lid shut
      a hit counts half, with it open \u2014 one and a half: strike while it fires."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398706
    m_Localized: Crybaby Doll
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398707
    m_Localized: 'Walks up and bursts into tears: the crying waves slow you down,
      and every other time she calls baby dolls.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398708
    m_Localized: A hit interrupts the crying. Take her out before the swarm gathers.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398709
    m_Localized: Crow
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398710
    m_Localized: From the Bogeyman's flock. Circles too high to hit; its shadow on
      the asphalt gives it away. Dives through where you stand and sometimes carries
      off a stray ball.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398711
    m_Localized: "A line flashes on the asphalt before the dive \u2014 step off it.
      Low over the ground any ball knocks a crow down."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398712
    m_Localized: Golden Matryoshka
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398713
    m_Localized: A tough matryoshka in a kokoshnik. Knocked out, she opens up and
      two roly-polys step out.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398714
    m_Localized: Keep balls ready for the two little ones.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398715
    m_Localized: Baby Doll in a Bonnet
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398716
    m_Localized: 'Swarm leader with a pacifier: while he lives, nearby baby dolls
      run faster, and he whimpers to call more.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398717
    m_Localized: "Take him out first \u2014 without the leader the swarm is back
      to normal."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398718
    m_Localized: Officer
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398719
    m_Localized: An officer with a sabre who comes with his own line, commands their
      volleys and throws a strong spiky hedgehog himself.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398720
    m_Localized: "Don't catch his hedgehog \u2014 dash away. Hit him while the line
      winds up."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398721
    m_Localized: Sailor Bear
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398722
    m_Localized: Holds two balls in his belly at once and spits them back at you.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398723
    m_Localized: "The spat-out balls can be caught \u2014 a perfect catch heals."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398724
    m_Localized: Rooster
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398725
    m_Localized: Runs at you, turning toward you twice on the way, and explodes bigger
      than a chick.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398726
    m_Localized: Dash away at the last moment or knock it out with a ball while it's
      still far away.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398727
    m_Localized: Sputnik Top
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398728
    m_Localized: A big top with antennas. Knocked out, it splits into two mini tops.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398729
    m_Localized: Launch it into a crowd like a normal top, and save balls for the
      mini tops.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398730
    m_Localized: Fire Horse
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398731
    m_Localized: Charges like a rocking horse but leaves a trail of fire behind.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398732
    m_Localized: Stay off the charge line and don't run through the trail. A hit
      breaks its rocking.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398733
    m_Localized: Department-Store Mannequin
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398734
    m_Localized: In a red dress and a hat. Freezes under your gaze like any mannequin,
      but turn away and she throws a strong ball at your back.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398735
    m_Localized: Don't turn your back on her. Only a perfect catch holds a strong
      ball.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398736
    m_Localized: Scarecrow in an Ushanka
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398737
    m_Localized: In a padded jacket with glowing eyes. Catches even charged balls,
      holds two and answers with a strong spiky hedgehog.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398738
    m_Localized: "Only from the side or back. Don't catch its hedgehog \u2014 dodge
      it."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398739
    m_Localized: Shadow in a Hat
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398740
    m_Localized: A shadow that puts out the lamps it flies past, leaving less light
      in the arena.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398741
    m_Localized: "Meet it with a \xABSmena\xBB camera flash and hit it as it winds
      up, while it's solid."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398742
    m_Localized: 'Queen of the yard: plows ahead, body-slams and lobs little roly-polys.
      Knocked out, she splits into two smaller ones, and those split again.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398743
    m_Localized: 'Keep your distance and watch the halves: when there are four, take
      them one at a time.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398744
    m_Localized: 'Boss of the hockey box. Throws strong balls and every few seconds
      whistles a new rule: Freeze!, Penalty!, Ball in play! or Substitution!'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398745
    m_Localized: 'Read the rule on screen: don''t run during Freeze!, catch the fan
      during Penalty! (not the hedgehogs), dash away from the giant ball.'
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398746
    m_Localized: A police Zhiguli that turns into a robot. As a car it rams and smashes
      stalls; as a robot it fires fans of balls, drops battery mines and calls in
      RC cars.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398747
    m_Localized: "Make him crash into a wall \u2014 stunned, he's open. Hit him while
      he transforms and right after a volley."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398748
    m_Localized: Hops after you and slams down in a circle, leaving cotton clouds
      that bog you down. Throws a carrot boomerang, whips with his ears up close,
      and at half health his seam rips.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398749
    m_Localized: "Leave the circle before he lands \u2014 after a jump he sits wide
      open. Steer clear of the cotton clouds."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398750
    m_Localized: The Bogeyman with a sack. Catches every ball from the front and
      answers with a fan, sweeps stray balls into his sack, puts out the lights,
      calls crows, vaults on his pole, hides among scarecrows and counts to five.
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398751
    m_Localized: "Hit him from the side or back \u2014 he turns slowly. A hit on
      the sack spills the balls; hide behind cover while he counts. Or just hold
      out until mom calls you home."
    m_Metadata:
      m_Items: []
  - m_Id: 4788928270819328
    m_Localized: Fence
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207936
    m_Localized: 'Q: put up a fence. Enemy balls bounce off.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207937
    m_Localized: Soap Bubbles
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207938
    m_Localized: 'Q: bubbles catch enemy balls.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207939
    m_Localized: Cap Gun
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207940
    m_Localized: 'Q: bang! Balls flying at you drop.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207941
    m_Localized: "\xABSmena\xBB Camera"
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207942
    m_Localized: 'Q: flash! Enemies in the frame freeze.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207943
    m_Localized: Magnet
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207944
    m_Localized: 'Q: balls around fly into your hands.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207945
    m_Localized: Rewind
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207946
    m_Localized: 'Q: rewind yourself 3 s back.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207947
    m_Localized: Merry-Go-Round
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207948
    m_Localized: 'Q: spin and throw all your balls in a ring.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207949
    m_Localized: Jump Elastic
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207950
    m_Localized: 'Q: an elastic to a friend. Enemies trip on it.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207951
    m_Localized: Walkie-Talkie
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207952
    m_Localized: "Q: mark an enemy \u2014 all balls fly at it."
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207953
    m_Localized: Counting Rhyme
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207954
    m_Localized: Every 3rd throw is charged.
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207959
    m_Localized: Tamagotchi
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207960
    m_Localized: Catch 5 balls and your pet saves you once.
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207963
    m_Localized: No One Left Behind
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207964
    m_Localized: "Pick up a friend \u2014 enemies around freeze."
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207965
    m_Localized: Fort
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207966
    m_Localized: 'Q: a plank fort. Enemy balls fly back.'
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207967
    m_Localized: Statues
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207968
    m_Localized: Hitting a frozen enemy shatters it.
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207969
    m_Localized: Basketball
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207970
    m_Localized: Arcs to your aim and hits everyone around.
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207971
    m_Localized: Ping-Pong Ball
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207972
    m_Localized: Fast. Bounces off anything up to 6 times.
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207973
    m_Localized: Football
    m_Metadata:
      m_Items: []
  - m_Id: 4788928279207974
    m_Localized: Rolls and knocks everyone down. Dash into it to kick.
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881536
    m_Localized: Serve
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881537
    m_Localized: The ball hops to 4 enemies, not 2.
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881538
    m_Localized: Dunk
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881539
    m_Localized: After landing the ball hops to an enemy and hits again.
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881540
    m_Localized: Smash
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881541
    m_Localized: Every bounce hits harder and faster.
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881542
    m_Localized: Penalty
    m_Metadata:
      m_Items: []
  - m_Id: 6627793570881543
    m_Localized: A dash kick goes full power.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
