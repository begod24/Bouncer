  m_Name: Content_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9709e1cdb23fa419990d29f684126c4e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 153544024064
    m_Localized: Big Roly-Poly
    m_Metadata:
      m_Items: []
  - m_Id: 153552412672
    m_Localized: Medicine ball
    m_Metadata:
      m_Items: []
  - m_Id: 153552412673
    m_Localized: 'Heavy: 2 damage (3 charged) and 1 damage to everyone within 2.6
      m.'
    m_Metadata:
      m_Items: []
  - m_Id: 153552412674
    m_Localized: Tennis balls
    m_Metadata:
      m_Items: []
  - m_Id: 153552412675
    m_Localized: Fly in a fan of three. The two extras vanish on the ground.
    m_Metadata:
      m_Items: []
  - m_Id: 153552412676
    m_Localized: Volleyball
    m_Metadata:
      m_Items: []
  - m_Id: 153552412677
    m_Localized: After a hit, bounces on to 2 more enemies in a row.
    m_Metadata:
      m_Items: []
  - m_Id: 153552412678
    m_Localized: Boomerang
    m_Metadata:
      m_Items: []
  - m_Id: 153552412679
    m_Localized: After 0.35 s in flight the ball turns back to you, hitting everyone
      on the way.
    m_Metadata:
      m_Items: []
  - m_Id: 153552412680
    m_Localized: On a rubber band
    m_Metadata:
      m_Items: []
  - m_Id: 153552412681
    m_Localized: Your fallen ball jumps back into your hands.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606976
    m_Localized: One more ball
    m_Metadata:
      m_Items: []
  - m_Id: 153556606977
    m_Localized: +1 ball of your own, in hand and in stock.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606978
    m_Localized: Split
    m_Metadata:
      m_Items: []
  - m_Id: 153556606979
    m_Localized: On the first hit the ball splits into two twins.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606980
    m_Localized: Sticky hands
    m_Metadata:
      m_Items: []
  - m_Id: 153556606981
    m_Localized: Catch window 35% longer, catch reach a bit further. The perfect
      moment stays the same.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606982
    m_Localized: Long arms
    m_Metadata:
      m_Items: []
  - m_Id: 153556606983
    m_Localized: Pick up balls and coins 50% further away.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606984
    m_Localized: New sneakers
    m_Metadata:
      m_Items: []
  - m_Id: 153556606985
    m_Localized: Run 12% faster.
    m_Metadata:
      m_Items: []
  - m_Id: 153556606986
    m_Localized: Sandwich
    m_Metadata:
      m_Items: []
  - m_Id: 153556606987
    m_Localized: +1 life. Grandma sent it.
    m_Metadata:
      m_Items: []
  - m_Id: 23928708784128
    m_Localized: Bouncy ball
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978432
    m_Localized: When it touches the ground, the ball bounces 1 m up and stays dangerous.
      +1 bounce per card.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978433
    m_Localized: Hot potato
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978434
    m_Localized: 'After a catch, your next throw explodes: 2 damage within 3 m.'
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978435
    m_Localized: Bubble gum
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978436
    m_Localized: The ball leaves a sticky pink trail that slows enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978437
    m_Localized: Slide tackle
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978438
    m_Localized: Your dash knocks enemies down and stuns them for 0.8 s. No damage,
      at most once per 0.8 s.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978439
    m_Localized: Hooliganism
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978440
    m_Localized: +1 damage per throw (not for twins), but one ball fewer.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978441
    m_Localized: Freeze!
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978442
    m_Localized: Every successful catch slows everything around for 1 s.
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978443
    m_Localized: Deflated ball
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978444
    m_Localized: Flies in a snake line and grazes every enemy within 0.8 m of its
      path. Never pops up.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509120
    m_Localized: Off the wall
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509121
    m_Localized: 'Every wall ricochet: +1 damage for this throw.'
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509122
    m_Localized: Slingshot
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509123
    m_Localized: A charged throw pierces every enemy in its way.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509124
    m_Localized: Eagle eye
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509125
    m_Localized: The ball curves toward the nearest enemy ahead (up to 14 m). Twins
      don't.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509126
    m_Localized: Domino
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509127
    m_Localized: 'A knocked-out enemy falls on neighbours within 2.3 m: 1 damage,
      and down the chain it goes.'
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509128
    m_Localized: Piggy bank
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509129
    m_Localized: 'At the newsstand: +1 coin for every 10 you hold. Takes no pocket.'
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509130
    m_Localized: Pot lid
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509131
    m_Localized: Blocks one hit or ball every 20 s.
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509132
    m_Localized: Yo-yo
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509133
    m_Localized: 'Boomerang + On a rubber band. One ball on a string: after a hit
      it flies back to you, hitting everyone on the way.'
    m_Metadata:
      m_Items: []
  - m_Id: 194562260721664
    m_Localized: Jump rope
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915968
    m_Localized: Dash 30% further, recharging 20% faster.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915969
    m_Localized: Pocket mirror
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915970
    m_Localized: Mannequins freeze behind your back too.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915971
    m_Localized: Flashlight
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915972
    m_Localized: Your light (5 m) makes shadows solid. The flashlight beam reaches
      3 m further and lasts 2 s longer.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915973
    m_Localized: Whistle
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915974
    m_Localized: A perfect catch freezes enemies within 6 m for 1.5 s.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915975
    m_Localized: Second wind
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915976
    m_Localized: Once per walk, a hit that would knock you out leaves you with one
      heart.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915977
    m_Localized: Grandma's pies
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915978
    m_Localized: +1 heart at the start of each next arena.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915979
    m_Localized: Rubber boots
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915980
    m_Localized: Sand, gum and puddles don't slow you down.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915981
    m_Localized: Bouncing bomb
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915982
    m_Localized: 'Hot potato + Bouncy ball. Every bounce off the ground explodes:
      1 damage within 2.2 m.'
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915983
    m_Localized: Hailstorm
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915984
    m_Localized: "Tennis balls + Split. Fan balls and twins split too \u2014 once."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915985
    m_Localized: Kettlebell
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915986
    m_Localized: Medicine ball + Hooliganism. Area hits stun everyone hit for 1 s.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915987
    m_Localized: Roll
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915988
    m_Localized: Slide tackle + Jump rope. A ball or hit passing close during a dash
      slows time for 0.5 s and powers up your next throw.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915989
    m_Localized: Cheat sheet
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915990
    m_Localized: The first reroll at every newsstand is free. Takes no pocket.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915991
    m_Localized: Lucky wrapper
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915992
    m_Localized: School bags and bosses offer 4 cards instead of 3. Takes no pocket.
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915993
    m_Localized: PE Teacher Mannequin
    m_Metadata:
      m_Items: []
  - m_Id: 377579491024896
    m_Localized: The One in the Dusk
    m_Metadata:
      m_Items: []
  - m_Id: 441337332621312
    m_Localized: Brainiac
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204224
    m_Localized: Loves books, a bit of a know-it-all
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204225
    m_Localized: Chubs
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204226
    m_Localized: Kind, always hungry, your best friend
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204227
    m_Localized: Shorty
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204228
    m_Localized: Fast, fearless, never sits still
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204229
    m_Localized: Hooligan
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204230
    m_Localized: Tough scrapper, boss of the yard
    m_Metadata:
      m_Items: []
  - m_Id: 1280561648754688
    m_Localized: Kiosk Transformer
    m_Metadata:
      m_Items: []
  - m_Id: 1280561657143296
    m_Localized: Big Plush Bunny
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
