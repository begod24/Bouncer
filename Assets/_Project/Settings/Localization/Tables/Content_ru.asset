  m_TableData:
  - m_Id: 153544024064
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u043D\u0435\u0432\u0430\u043B\u044F\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412672
    m_Localized: "\u041D\u0430\u0431\u0438\u0432\u043D\u043E\u0439 \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412673
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439.
      \u0411\u044C\u0451\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0438
      \u0437\u0430\u0434\u0435\u0432\u0430\u0435\u0442 \u0432\u0441\u0435\u0445 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0446\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412674
    m_Localized: "\u0422\u0435\u043D\u043D\u0438\u0441\u043D\u044B\u0435 \u043C\u044F\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412675
    m_Localized: "\u041B\u0435\u0442\u044F\u0442 \u0432\u0435\u0435\u0440\u043E\u043C
      \u043F\u043E \u0442\u0440\u0438. \u041B\u0438\u0448\u043D\u0438\u0435 \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442,
      \u043A\u043E\u0441\u043D\u0443\u0432\u0448\u0438\u0441\u044C \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412676
    m_Localized: "\u0412\u043E\u043B\u0435\u0439\u0431\u043E\u043B\u044C\u043D\u044B\u0439
      \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412677
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
      \u043E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442 \u0435\u0449\u0451
      \u0432 \u0434\u0432\u0443\u0445 \u0432\u0440\u0430\u0433\u043E\u0432 \u043F\u043E\u0434\u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412678
    m_Localized: "\u0411\u0443\u043C\u0435\u0440\u0430\u043D\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412679
    m_Localized: "\u041C\u044F\u0447 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u043E\u043B\u0451\u0442\u0435 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0440\u0443\u043A\u0438, \u0441\u0431\u0438\u0432\u0430\u044F \u0432\u0441\u0435\u0445
      \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412680
    m_Localized: "\u041D\u0430 \u0440\u0435\u0437\u0438\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412681
    m_Localized: "\u0423\u043F\u0430\u0432\u0448\u0438\u0439 \u043C\u044F\u0447 \u0441\u0430\u043C
      \u043F\u0440\u044B\u0433\u0430\u0435\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606976
    m_Localized: "\u0415\u0449\u0451 \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606977
    m_Localized: "+1 \u043C\u044F\u0447 \u0432 \u0440\u0443\u043A\u0438 \u0438 \u0432
      \u0437\u0430\u043F\u0430\u0441. \u0414\u043E \u0442\u0440\u0451\u0445 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606978
    m_Localized: "\u0420\u0430\u0437\u0434\u0432\u043E\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606979
    m_Localized: "\u041F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u043C \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438
      \u043C\u044F\u0447 \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0430 \u0438 \u043B\u0435\u0442\u0438\u0442 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606980
    m_Localized: "\u0426\u0435\u043F\u043A\u0438\u0435 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606981
    m_Localized: "\u041E\u043A\u043D\u043E \u043B\u043E\u0432\u043B\u0438 \u0434\u043B\u0438\u043D\u043D\u0435\u0435
      \u043D\u0430 35%, \u043B\u043E\u0432\u0438\u0448\u044C \u0447\u0443\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0414\u043E \u0442\u0440\u0451\u0445
      \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606982
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606983
    m_Localized: "\u041F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0448\u044C \u043C\u044F\u0447\u0438
      \u0441 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0432
      \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0440\u0430\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u0414\u043E \u0434\u0432\u0443\u0445 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606984
    m_Localized: "\u041D\u043E\u0432\u044B\u0435 \u043A\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606985
    m_Localized: "\u0411\u0435\u0433\u0430\u0435\u0448\u044C \u043D\u0430 12% \u0431\u044B\u0441\u0442\u0440\u0435\u0435.
      \u0414\u043E \u0442\u0440\u0451\u0445 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606986
    m_Localized: "\u0411\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606987
    m_Localized: "+1 \u0436\u0438\u0437\u043D\u044C. \u0411\u0430\u0431\u0443\u0448\u043A\u0430
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  references:
