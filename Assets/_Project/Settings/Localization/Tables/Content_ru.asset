      m_Items: []
  - m_Id: 194562264915971
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915972
    m_Localized: "\u0421\u0432\u0435\u0442 \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u0435\u0431\u044F
      (5 \u043C) \u0434\u0435\u043B\u0430\u0435\u0442 \u0442\u0435\u043D\u044C \u0442\u0432\u0451\u0440\u0434\u043E\u0439.
      \u041B\u0443\u0447 \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0430 \u043D\u0430
      3 \u043C \u0434\u043B\u0438\u043D\u043D\u0435\u0435 \u0438 \u0441\u0432\u0435\u0442\u0438\u0442
      \u043D\u0430 2 \u0441 \u0434\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915973
    m_Localized: "\u0421\u0432\u0438\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915974
    m_Localized: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043B\u043E\u0432\u043B\u044F
      \u0437\u0430\u043C\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
      \u0432 6 \u043C \u043D\u0430 1,5 \u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915975
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915976
    m_Localized: "\u0420\u0430\u0437 \u0437\u0430 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0443
      \u0443\u0434\u0430\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B\u0431\u0438\u043B
      \u0431\u044B \u0442\u0435\u0431\u044F, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043E\u0434\u043D\u043E \u0441\u0435\u0440\u0434\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915977
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u044B \u043F\u0438\u0440\u043E\u0436\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915978
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0430\u0440\u0435\u043D\u044B
      +1 \u0441\u0435\u0440\u0434\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915979
    m_Localized: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u0441\u0430\u043F\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915980
    m_Localized: "\u041F\u0435\u0441\u043E\u043A, \u0436\u0432\u0430\u0447\u043A\u0430
      \u0438 \u043B\u0443\u0436\u0438 \u0442\u0435\u0431\u044F \u043D\u0435 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915981
    m_Localized: "\u041F\u0440\u044B\u0433\u0430\u044E\u0449\u0430\u044F \u0431\u043E\u043C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915982
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0430\u044F \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0430
      + \u041F\u043E\u043F\u0440\u044B\u0433\u0443\u043D\u0447\u0438\u043A. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043E\u0442\u0441\u043A\u043E\u043A \u043E\u0442 \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430
      \u2014 \u0432\u0437\u0440\u044B\u0432: 1 \u0443\u0440\u043E\u043D \u0432 2,2
      \u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915983
    m_Localized: "\u0413\u0440\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915984
    m_Localized: "\u0422\u0435\u043D\u043D\u0438\u0441\u043D\u044B\u0435 \u043C\u044F\u0447\u0438
      + \u0420\u0430\u0437\u0434\u0432\u043E\u0435\u043D\u0438\u0435. \u041C\u044F\u0447\u0438
      \u0432\u0435\u0435\u0440\u0430 \u0438 \u0434\u0432\u043E\u0439\u043D\u0438\u043A\u0438
      \u0442\u043E\u0436\u0435 \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u2014 \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915985
    m_Localized: "\u0413\u0438\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915986
    m_Localized: "\u041D\u0430\u0431\u0438\u0432\u043D\u043E\u0439 \u043C\u044F\u0447
      + \u0425\u0443\u043B\u0438\u0433\u0430\u043D\u0441\u0442\u0432\u043E. \u0423\u0434\u0430\u0440
      \u043F\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442
      \u0432\u0441\u0435\u0445 \u0437\u0430\u0434\u0435\u0442\u044B\u0445 \u043D\u0430
      1 \u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915987
    m_Localized: "\u041A\u0443\u0432\u044B\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915988
    m_Localized: "\u041F\u043E\u0434\u043A\u0430\u0442 + \u0421\u043A\u0430\u043A\u0430\u043B\u043A\u0430.
      \u041C\u044F\u0447 \u0438\u043B\u0438 \u0443\u0434\u0430\u0440 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0440\u044F\u0434\u043E\u043C \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0440\u044B\u0432\u043A\u0430 \u2014 \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u0435
      \u043D\u0430 0,5 \u0441 \u0438 \u0431\u0440\u043E\u0441\u043E\u043A \u0441
      \u0441\u0438\u043B\u043E\u0439 \u0441\u0432\u0435\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915989
    m_Localized: "\u0428\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915990
    m_Localized: "\u0412 \u043A\u0430\u0436\u0434\u043E\u043C \u043B\u0430\u0440\u044C\u043A\u0435
      \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u0435\u0440\u0435\u0431\u043E\u0440
      \u0432\u0438\u0442\u0440\u0438\u043D\u044B \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439.
      \u041D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043A\u0430\u0440\u043C\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915991
    m_Localized: "\u0421\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439 \u0444\u0430\u043D\u0442\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915992
    m_Localized: "\u0412 \u043F\u043E\u0440\u0442\u0444\u0435\u043B\u0435 \u0438
      \u0437\u0430 \u0431\u043E\u0441\u0441\u0430 \u2014 \u0432\u044B\u0431\u043E\u0440
      \u0438\u0437 4 \u043A\u0430\u0440\u0442\u043E\u0447\u0435\u043A. \u041D\u0435
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043A\u0430\u0440\u043C\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915993
    m_Localized: "\u0424\u0438\u0437\u0440\u0443\u043A-\u043C\u0430\u043D\u0435\u043A\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 377579491024896
    m_Localized: "\u0422\u043E\u0442, \u043A\u0442\u043E \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 441337332621312
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204224
    m_Localized: "\u041B\u044E\u0431\u0438\u0442 \u043A\u043D\u0438\u0433\u0438,
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0437\u0430\u0443\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204225
    m_Localized: "\u0422\u043E\u043B\u0441\u0442\u044F\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204226
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439, \u0432\u0441\u0435\u0433\u0434\u0430
      \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0439, \u043B\u0443\u0447\u0448\u0438\u0439
      \u0434\u0440\u0443\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204227
    m_Localized: "\u041C\u0435\u043B\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204228
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F, \u0441\u043C\u0435\u043B\u0430\u044F,
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204229
    m_Localized: "\u0425\u0443\u043B\u0438\u0433\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 441337345204230
    m_Localized: "\u041A\u0440\u0443\u0442\u043E\u0439 \u0434\u0440\u0430\u0447\u0443\u043D,
      \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0432\u043E \u0434\u0432\u043E\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1280561648754688
    m_Localized: "\u0422\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0435\u0440
      \u0438\u0437 \u043B\u0430\u0440\u044C\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1280561657143296
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u043B\u044E\u0448\u0435\u0432\u044B\u0439
      \u0437\u0430\u044F\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588239204352
    m_Localized: "\u041D\u0435\u0432\u0430\u043B\u044F\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398656
    m_Localized: "\u0418\u0434\u0451\u0442 \u043D\u0430 \u0442\u0435\u0431\u044F
      \u0432\u0440\u0430\u0437\u0432\u0430\u043B\u043A\u0443 \u0438 \u0431\u044C\u0451\u0442
      \u0442\u0435\u043B\u043E\u043C. \u041E\u0442 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
      \u0437\u0430\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0441\u0430\u043C\u0430 \u0432\u0441\u0442\u0430\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398657
    m_Localized: "\u041E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u0421\u0442\u043E\u044F\u0442
      \u043A\u0443\u0447\u043A\u043E\u0439 \u2014 \u0431\u0435\u0439 \u043F\u043E
      \u043A\u0440\u0430\u0439\u043D\u0435\u0439: \u043F\u0430\u0434\u0430\u044F,
      \u043E\u043D\u0430 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0441\u043E\u0441\u0435\u0434\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398658
    m_Localized: "\u041F\u0443\u043F\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398659
    m_Localized: "\u0411\u0435\u0433\u0430\u0435\u0442 \u0440\u043E\u0435\u043C,
      \u0440\u0430\u0441\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u044F \u0441\u043E\u0441\u0435\u0434\u0435\u0439;
      \u0432\u0431\u043B\u0438\u0437\u0438 \u043F\u0440\u0438\u0441\u0435\u0434\u0430\u0435\u0442
      \u0438 \u043F\u0440\u044B\u0433\u0430\u0435\u0442, \u043A\u0443\u0441\u0430\u044F\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398660
    m_Localized: "\u0412\u044B\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435\u043C, \u0430 \u043C\u044F\u0447
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C
      \u2014 \u0431\u0440\u043E\u0441\u0430\u0439 \u0432\u0434\u043E\u043B\u044C
      \u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398661
    m_Localized: "\u041E\u043B\u043E\u0432\u044F\u043D\u043D\u044B\u0439 \u0441\u043E\u043B\u0434\u0430\u0442\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398662
    m_Localized: "\u0425\u043E\u0434\u0438\u0442 \u0441\u0442\u0440\u043E\u0435\u043C:
      \u0448\u0435\u0440\u0435\u043D\u0433\u0430 \u0432\u0441\u0442\u0430\u0451\u0442
      \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u0440\u0430\u0437\u043E\u043C
      \u0437\u0430\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0438
      \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u043A\u043E\u043B\u044E\u0447\u0435\u0433\u043E \u0451\u0436\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398663
    m_Localized: "\u0415\u0433\u043E \u043C\u044F\u0447\u0438 \u043C\u043E\u0436\u043D\u043E
      \u043B\u043E\u0432\u0438\u0442\u044C \u2014 \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0441 \u043C\u044F\u0447\u0435\u0439 \u0438 \u0441\u0435\u0440\u0434\u0435\u0446.
      \u0401\u0436\u0438\u043A\u0430 (\u043A\u0440\u0430\u0441\u043D\u044B\u0439,
      \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F) \u043D\u0435 \u043B\u043E\u0432\u0438
      \u2014 \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398664
    m_Localized: "\u041F\u043B\u044E\u0448\u0435\u0432\u044B\u0439 \u043C\u0438\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398665
    m_Localized: "\u041C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439 \u0442\u0430\u043D\u043A:
      \u0438\u0434\u0451\u0442 \u043D\u0430\u043F\u0440\u043E\u043B\u043E\u043C \u0438
      \u0431\u044C\u0451\u0442 \u043B\u0430\u043F\u043E\u0439 \u0432\u0431\u043B\u0438\u0437\u0438.
      \u041C\u044F\u0447 \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u0435\u0442
      \u0443 \u043D\u0435\u0433\u043E \u0432 \u0436\u0438\u0432\u043E\u0442\u0435
      \u2014 \u0443 \u0442\u0435\u0431\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043C\u044F\u0447 \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398666
    m_Localized: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u043C
      \u043C\u044F\u0447\u043E\u043C \u0432\u044B\u0431\u0438\u0432\u0430\u0435\u0442
      \u0437\u0430\u0441\u0442\u0440\u044F\u0432\u0448\u0438\u0439 \u043D\u0430 \u043F\u043E\u043B,
      \u0430 \u0432\u044B\u0431\u0438\u0442\u044B\u0439 \u043C\u0438\u0448\u043A\u0430
      \u0440\u043E\u043D\u044F\u0435\u0442 \u0432\u0441\u0451. \u041D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438
      \u043D\u0430 \u0443\u0434\u0430\u0440 \u043B\u0430\u043F\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398667
    m_Localized: "\u0417\u0430\u0432\u043E\u0434\u043D\u043E\u0439 \u0446\u044B\u043F\u043B\u0451\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398668
    m_Localized: "\u0417\u0430\u0432\u043E\u0434\u0438\u0442\u0441\u044F (\u043A\u043B\u044E\u0447
      \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F \u0438 \u0438\u0441\u043A\u0440\u0438\u0442),
      \u0431\u0435\u0436\u0438\u0442 \u043F\u043E \u043F\u0440\u044F\u043C\u043E\u0439
      \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0442\u044B \u0441\u0442\u043E\u044F\u043B,
      \u0438 \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u0412\u0437\u0440\u044B\u0432
      \u0431\u044C\u0451\u0442 \u0432\u0441\u0435\u0445 \u0432\u043E\u043A\u0440\u0443\u0433,
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398669
    m_Localized: "\u041F\u043E\u043A\u0430 \u043E\u043D \u0437\u0430\u0432\u043E\u0434\u0438\u0442\u0441\u044F
      \u2014 \u043E\u0442\u043E\u0439\u0434\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u0421\u0431\u0438\u0442\u044B\u0439 \u043C\u044F\u0447\u043E\u043C \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435: \u043F\u043E\u0434\u043E\u0440\u0432\u0438
      \u0435\u0433\u043E \u0432 \u0442\u043E\u043B\u043F\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398670
    m_Localized: "\u042E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398671
    m_Localized: "\u041A\u0440\u0443\u0442\u0438\u0442\u0441\u044F \u0438 \u043A\u0430\u0442\u0438\u0442\u0441\u044F
      \u043A \u0442\u0435\u0431\u0435 \u043F\u043E \u0434\u0443\u0433\u0435, \u0441\u0431\u0438\u0432\u0430\u0435\u0442
      \u043F\u0440\u0438 \u043A\u0430\u0441\u0430\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398672
    m_Localized: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0435\u0451, \u043A\u0430\u043A \u0431\u0438\u043B\u044C\u044F\u0440\u0434\u043D\u044B\u0439
      \u0448\u0430\u0440: \u0446\u0435\u043B\u044C\u0441\u044F \u0442\u0430\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430 \u043F\u043E\u043B\u0435\u0442\u0435\u043B\u0430
      \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398673
    m_Localized: "\u041B\u043E\u0448\u0430\u0434\u043A\u0430-\u043A\u0430\u0447\u0430\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398674
    m_Localized: "\u0420\u0430\u0441\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0432\u0441\u0451 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
      \u0438 \u0442\u0430\u0440\u0430\u043D\u0438\u0442 \u043F\u043E \u043F\u0440\u044F\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398675
    m_Localized: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0441\u043A\u0430\u0447\u043A\u0438
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0437\u0431\u0435\u0433.
      \u041F\u043E\u0441\u043B\u0435 \u0442\u0430\u0440\u0430\u043D\u0430 \u043E\u043D\u0430
      \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
      \u2014 \u0442\u0443\u0442 \u0438 \u0431\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398676
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u0438\u043A \u0441 \u043A\u0440\u044B\u0448\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398677
    m_Localized: "\u0418\u0434\u0451\u0442 \u043D\u0430 \u0442\u0435\u0431\u044F,
      \u0434\u0435\u0440\u0436\u0430 \u043A\u0440\u044B\u0448\u043A\u0443 \u043E\u0442
      \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u0438 \u043F\u0435\u0440\u0435\u0434
      \u0441\u043E\u0431\u043E\u0439: \u043C\u044F\u0447 \u0441\u043F\u0435\u0440\u0435\u0434\u0438
      \u043E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442, \u043A\u0430\u043A
      \u043E\u0442 \u0441\u0442\u0435\u043D\u044B. \u0412\u0431\u043B\u0438\u0437\u0438
      \u0431\u044C\u0451\u0442 \u043F\u043E\u043B\u043E\u0432\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398678
    m_Localized: "\u0411\u0435\u0439 \u0441\u0431\u043E\u043A\u0443, \u0441\u0437\u0430\u0434\u0438,
      \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u043E\u043C \u0438\u043B\u0438 \u0431\u0443\u043C\u0435\u0440\u0430\u043D\u0433\u043E\u043C.
      \u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439 \u043C\u044F\u0447
      \u0432\u044B\u0431\u0438\u0432\u0430\u0435\u0442 \u043A\u0440\u044B\u0448\u043A\u0443
      \u2014 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u043D
      \u043E\u0442\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398679
    m_Localized: "\u041F\u0438\u043E\u043D\u0435\u0440-\u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398680
    m_Localized: "\u0421\u0430\u043C \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u0435\u0442:
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043F\u043E\u0437\u0430\u0434\u0438
      \u0438 \u0431\u044C\u0451\u0442 \u0432 \u0431\u0430\u0440\u0430\u0431\u0430\u043D.
      \u041F\u043E\u0434 \u0435\u0433\u043E \u0431\u0430\u0440\u0430\u0431\u0430\u043D
      \u0441\u043E\u0441\u0435\u0434\u0438 \u0431\u0435\u0433\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398681
    m_Localized: "\u0412\u044B\u0431\u0438\u0432\u0430\u0439 \u043F\u0435\u0440\u0432\u044B\u043C.
      \u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u0431\u0438\u0432\u0430\u0435\u0442
      \u0440\u0438\u0442\u043C \u2014 \u0431\u0430\u0440\u0430\u0431\u0430\u043D
      \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398682
    m_Localized: "\u0417\u0430\u0432\u043E\u0434\u043D\u0430\u044F \u043B\u044F\u0433\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398683
    m_Localized: "\u041F\u0440\u044B\u0433\u0430\u0435\u0442 \u043A \u0442\u0435\u0431\u0435
      \u0434\u0443\u0433\u043E\u0439, \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0435
      \u0431\u044C\u0451\u0442 \u043F\u043E \u043A\u0440\u0443\u0433\u0443 \u2014
      \u043E\u043D \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0432\u0438\u0434\u0435\u043D
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398684
    m_Localized: "\u041C\u044F\u0447 \u0432 \u043F\u0440\u044B\u0436\u043A\u0435
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0435\u0451 \u043D\u0430 \u0441\u043F\u0438\u043D\u0443.
      \u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u0432\u043E\u0434 \u043A\u043E\u043D\u0447\u0430\u0435\u0442\u0441\u044F,
      \u043E\u043D\u0430 \u0441\u0438\u0434\u0438\u0442 \u0438 \u0437\u0430\u0432\u043E\u0434\u0438\u0442\u0441\u044F
      \u2014 \u043E\u043A\u043D\u043E \u0434\u043B\u044F \u0431\u0440\u043E\u0441\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398685
    m_Localized: "\u041C\u0430\u0448\u0438\u043D\u043A\u0430 \u043D\u0430 \u043F\u0443\u043B\u044C\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398686
    m_Localized: "\u041D\u043E\u0441\u0438\u0442\u0441\u044F \u043A\u0440\u0443\u0433\u0430\u043C\u0438,
      \u043F\u043E\u0442\u043E\u043C \u0433\u0430\u0437\u0443\u0435\u0442 \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435 \u0438 \u0442\u0430\u0440\u0430\u043D\u0438\u0442
      \u043F\u043E \u043F\u0440\u044F\u043C\u043E\u0439, \u0432 \u043A\u043E\u043D\u0446\u0435
      \u0443\u0445\u043E\u0434\u044F \u0432 \u0437\u0430\u043D\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398687
    m_Localized: "\u041C\u044F\u0447 \u043F\u0435\u0440\u0435\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0435\u0451 \u043A\u043E\u043B\u0451\u0441\u0430\u043C\u0438 \u0432\u0432\u0435\u0440\u0445
      \u2014 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u043D\u0430
      \u0431\u0435\u0441\u043F\u043E\u043C\u043E\u0449\u043D\u0430. \u0411\u0443\u043A\u0441\u0443\u0435\u0442
      \u2014 \u0443\u0445\u043E\u0434\u0438 \u0441 \u0435\u0451 \u043B\u0438\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398688
    m_Localized: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043E\u0442 \xAB\u0414\u0435\u043D\u0434\u0438\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398689
    m_Localized: "\u0421\u043A\u0430\u0447\u0435\u0442 \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0435
      \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438,
      \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u0432\u043E\u0434\u0438\u0442 \u043B\u0430\u0437\u0435\u0440:
      \u043B\u0443\u0447 \u0438 \u043F\u043E\u043B\u043E\u0441\u0430 \u043D\u0430
      \u0437\u0435\u043C\u043B\u0435 \u0432\u0435\u0434\u0443\u0442 \u0442\u0435\u0431\u044F
      \u0438 \u0437\u0430\u043C\u0438\u0440\u0430\u044E\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398690
    m_Localized: "\u0412\u044B\u0441\u0442\u0440\u0435\u043B \u043D\u0435 \u043F\u043E\u0439\u043C\u0430\u0442\u044C
      \u2014 \u044D\u0442\u043E \u0441\u0432\u0435\u0442. \u041F\u043E\u043B\u043E\u0441\u0430
      \u0437\u0430\u043C\u0435\u0440\u043B\u0430 \u2014 \u0443\u0439\u0434\u0438
      \u0441 \u043B\u0438\u043D\u0438\u0438. \u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u0438\u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398691
    m_Localized: "\u041C\u0430\u043D\u0435\u043A\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398692
    m_Localized: "\u041F\u043E\u043A\u0430 \u0442\u044B \u043D\u0430 \u043D\u0435\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C, \u0441\u0442\u043E\u0438\u0442
      \u043A\u0430\u043A \u0432\u043A\u043E\u043F\u0430\u043D\u043D\u044B\u0439 \u2014
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u0432 \u043D\u043E\u0432\u043E\u0439
      \u043F\u043E\u0437\u0435. \u041E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u2014 \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u043E\u0434\u043A\u0440\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0431\u044C\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398693
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0434
      \u0441\u043E\u0431\u043E\u0439 \u0438 \u0431\u0435\u0439: \u043F\u043E\u043F\u0430\u0434\u0430\u0442\u044C
      \u043C\u043E\u0436\u043D\u043E \u0432\u0441\u0435\u0433\u0434\u0430, \u0430
      \u0432\u0437\u0433\u043B\u044F\u0434 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0434\u0430\u0436\u0435 \u0435\u0433\u043E \u0437\u0430\u043C\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398694
    m_Localized: "\u0427\u0443\u0447\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398695
    m_Localized: "\u041F\u0440\u044B\u0433\u0430\u0435\u0442 \u043D\u0430 \u0448\u0435\u0441\u0442\u0435
      \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438.
      \u0420\u0443\u043A\u0438 \u043B\u043E\u0432\u044F\u0442 \u043C\u044F\u0447\u0438
      \u0441\u043F\u0435\u0440\u0435\u0434\u0438 \u0438 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0431\u0440\u043E\u0441\u0430\u044E\u0442
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398696
    m_Localized: "\u0411\u0435\u0439 \u0441\u0431\u043E\u043A\u0443 \u0438\u043B\u0438
      \u0441\u0437\u0430\u0434\u0438 \u2014 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043E\u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439
      \u043C\u044F\u0447 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u0440\u0443\u043A\u0438,
      \u0430 \u0435\u0433\u043E \u043E\u0442\u0432\u0435\u0442 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0439\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398697
    m_Localized: "\u0422\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398698
    m_Localized: "\u0412\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B
      \u0438 \u043F\u043B\u044B\u0432\u0451\u0442 \u043A \u0442\u0435\u0431\u0435.
      \u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043C\u044F\u0447\u0438
      \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u0441\u043A\u0432\u043E\u0437\u044C
      \u043D\u0435\u0451, \u043D\u0430 \u0441\u0432\u0435\u0442\u0443 \u0444\u043E\u043D\u0430\u0440\u044F
      \u043E\u043D\u0430 \u0442\u0432\u0451\u0440\u0434\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398699
    m_Localized: "\u0421\u0442\u043E\u0439 \u043F\u043E\u0434 \u0444\u043E\u043D\u0430\u0440\u0451\u043C
      \u2014 \u0435\u0439 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u044B\u0439\u0442\u0438
      \u043D\u0430 \u0441\u0432\u0435\u0442. \u041D\u0430 \u0437\u0430\u043C\u0430\u0445\u0435
      \u0442\u0435\u043D\u044C \u043F\u043B\u043E\u0442\u043D\u0435\u0435\u0442 \u0433\u0434\u0435
      \u0443\u0433\u043E\u0434\u043D\u043E, \u0430 \u0444\u043E\u043D\u0430\u0440\u0438\u043A
      (Q) \u0435\u0451 \u0436\u0436\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398700
    m_Localized: "\u0411\u0430\u043B\u0435\u0440\u0438\u043D\u0430 \u0438\u0437 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398701
    m_Localized: "\u041A\u0440\u0443\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u0435
      \u0438 \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442 \u043A \u0442\u0435\u0431\u0435:
      \u043C\u044F\u0447, \u043F\u0440\u0438\u043B\u0435\u0442\u0435\u0432\u0448\u0438\u0439
      \u0432 \u043F\u0438\u0440\u0443\u044D\u0442, \u043E\u0431\u043B\u0435\u0442\u0430\u0435\u0442
      \u0435\u0451 \u0438 \u043B\u0435\u0442\u0438\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398702
    m_Localized: "\u0411\u0435\u0439 \u043F\u043E\u0441\u043B\u0435 \u043F\u0438\u0440\u0443\u044D\u0442\u0430,
      \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0440\u0435\u0432\u0435\u0440\u0430\u043D\u0441. \u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439
      \u043C\u044F\u0447 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u043F\u0438\u0440\u0443\u044D\u0442,
      \u0430 \u043E\u0442\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0439\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398703
    m_Localized: "\u041B\u0443\u043D\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398704
    m_Localized: "\u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0435\u0437\u0434\u0438\u0442
      \u043D\u0430 \u0432\u043E\u0441\u044C\u043C\u0438 \u043A\u043E\u043B\u0451\u0441\u0430\u0445
      \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438.
      \u041F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u043A\u0440\u044B\u0448\u043A\u0443-\u0431\u0430\u0442\u0430\u0440\u0435\u044E
      \u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0432\u0435\u0435\u0440
      \u043A\u043E\u043B\u044E\u0447\u0438\u0445 \u0451\u0436\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398705
    m_Localized: "\u0401\u0436\u0438\u043A\u043E\u0432 \u043D\u0435 \u043F\u043E\u0439\u043C\u0430\u0442\u044C
      \u2014 \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F.
      \u0421 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439 \u043A\u0440\u044B\u0448\u043A\u043E\u0439
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0438\u0434\u0451\u0442
      \u0437\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443, \u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u2014 \u0437\u0430 \u043F\u043E\u043B\u0442\u043E\u0440\u0430: \u0431\u0435\u0439,
      \u043F\u043E\u043A\u0430 \u043E\u043D \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398706
    m_Localized: "\u041A\u0443\u043A\u043B\u0430-\u043F\u043B\u0430\u043A\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398707
    m_Localized: "\u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0438 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043F\u043B\u0430\u0447\u0435\u043C: \u0432\u043E\u043B\u043D\u044B \u043A\u0440\u0438\u043A\u0430
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442 \u0442\u0435\u0431\u044F,
      \u0430 \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0437 \u043E\u043D\u0430
      \u0437\u043E\u0432\u0451\u0442 \u043F\u0443\u043F\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398708
    m_Localized: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u0435\u0442
      \u043F\u043B\u0430\u0447. \u0412\u044B\u0431\u0438\u0432\u0430\u0439 \u0435\u0451,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398709
    m_Localized: "\u0412\u043E\u0440\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398710
    m_Localized: "\u0418\u0437 \u0441\u0442\u0430\u0438 \u0411\u0430\u0431\u0430\u044F.
      \u041A\u0440\u0443\u0436\u0438\u0442 \u0432\u044B\u0441\u043E\u043A\u043E \u2014
      \u043C\u044F\u0447\u043E\u043C \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u044C,
      \u0433\u0434\u0435 \u043E\u043D\u0430, \u0432\u044B\u0434\u0430\u0451\u0442
      \u0442\u0435\u043D\u044C \u043D\u0430 \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0435.
      \u041F\u0438\u043A\u0438\u0440\u0443\u0435\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0442\u043E \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435 \u0442\u044B
      \u0441\u0442\u043E\u0438\u0448\u044C, \u0438\u043D\u043E\u0433\u0434\u0430
      \u0443\u043D\u043E\u0441\u0438\u0442 \u0447\u0443\u0436\u043E\u0439 \u043C\u044F\u0447
      \u0441 \u0437\u0435\u043C\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398711
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u043F\u0438\u043A\u0435 \u043D\u0430
      \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0435 \u043C\u0438\u0433\u0430\u0435\u0442
      \u043F\u043E\u043B\u043E\u0441\u0430 \u2014 \u0443\u0439\u0434\u0438 \u0441
      \u043D\u0435\u0451. \u041D\u0438\u0437\u043A\u043E \u043D\u0430\u0434 \u0437\u0435\u043C\u043B\u0451\u0439
      \u0432\u043E\u0440\u043E\u043D\u0443 \u0441\u0431\u0438\u0432\u0430\u0435\u0442
      \u043B\u044E\u0431\u043E\u0439 \u043C\u044F\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398712
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u0430\u044F \u043C\u0430\u0442\u0440\u0451\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398713
    m_Localized: "\u041A\u0440\u0435\u043F\u043A\u0430\u044F \u043C\u0430\u0442\u0440\u0451\u0448\u043A\u0430
      \u0432 \u043A\u043E\u043A\u043E\u0448\u043D\u0438\u043A\u0435. \u0412\u044B\u0431\u0438\u0442\u0430\u044F
      \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u2014
      \u0438\u0437 \u043D\u0435\u0451 \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u0434\u0432\u0435 \u043D\u0435\u0432\u0430\u043B\u044F\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398714
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u043C\u044F\u0447\u0438 \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435
      \u0434\u043B\u044F \u0434\u0432\u0443\u0445 \u043C\u0430\u043B\u044B\u0448\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398715
    m_Localized: "\u041F\u0443\u043F\u0441 \u0432 \u0447\u0435\u043F\u0447\u0438\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398716
    m_Localized: "\u0412\u043E\u0436\u0430\u043A \u0440\u043E\u044F \u0441 \u0441\u043E\u0441\u043A\u043E\u0439:
      \u043F\u043E\u043A\u0430 \u043E\u043D \u0436\u0438\u0432, \u043F\u0443\u043F\u0441\u044B
      \u0440\u044F\u0434\u043E\u043C \u0431\u0435\u0433\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0430 \u0441\u0430\u043C \u043E\u043D \u0445\u043D\u044B\u0447\u0435\u0442
      \u0438 \u0441\u043E\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u043E\u0432\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398717
    m_Localized: "\u0412\u044B\u0431\u0435\u0439 \u0435\u0433\u043E \u043F\u0435\u0440\u0432\u044B\u043C
      \u2014 \u0431\u0435\u0437 \u0432\u043E\u0436\u0430\u043A\u0430 \u0440\u043E\u0439
      \u0441\u043D\u043E\u0432\u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398718
    m_Localized: "\u041E\u0444\u0438\u0446\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398719
    m_Localized: "\u041E\u0444\u0438\u0446\u0435\u0440 \u0441 \u0441\u0430\u0431\u043B\u0435\u0439
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0441\u043E \u0441\u0432\u043E\u0435\u0439
      \u0448\u0435\u0440\u0435\u043D\u0433\u043E\u0439, \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0435\u0442
      \u0437\u0430\u043B\u043F\u0430\u043C\u0438 \u0438 \u0441\u0430\u043C \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u044E\u0447\u0435\u0433\u043E
      \u0451\u0436\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398720
    m_Localized: "\u0415\u0433\u043E \u0451\u0436\u0438\u043A\u0430 \u043D\u0435
      \u043B\u043E\u0432\u0438 \u2014 \u0443\u0445\u043E\u0434\u0438 \u0440\u044B\u0432\u043A\u043E\u043C.
      \u0411\u0435\u0439, \u043F\u043E\u043A\u0430 \u0448\u0435\u0440\u0435\u043D\u0433\u0430
      \u0437\u0430\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398721
    m_Localized: "\u041C\u0438\u0448\u043A\u0430-\u043C\u043E\u0440\u044F\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398722
    m_Localized: "\u0414\u0435\u0440\u0436\u0438\u0442 \u0432 \u0436\u0438\u0432\u043E\u0442\u0435
      \u0441\u0440\u0430\u0437\u0443 \u0434\u0432\u0430 \u043C\u044F\u0447\u0430
      \u0438 \u0432\u044B\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u0435\u0442 \u0438\u0445
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398723
    m_Localized: "\u0412\u044B\u043F\u043B\u044E\u043D\u0443\u0442\u044B\u0435 \u043C\u044F\u0447\u0438
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u2014
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043B\u043E\u0432\u043B\u044F
      \u043B\u0435\u0447\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398724
    m_Localized: "\u041F\u0435\u0442\u0443\u0448\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398725
    m_Localized: "\u0411\u0435\u0436\u0438\u0442, \u0434\u0432\u0430\u0436\u0434\u044B
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F \u043A \u0442\u0435\u0431\u0435
      \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435, \u0438 \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0446\u044B\u043F\u043B\u0451\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398726
    m_Localized: "\u0423\u0445\u043E\u0434\u0438 \u0440\u044B\u0432\u043A\u043E\u043C
      \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0438\u043B\u0438 \u0441\u0431\u0435\u0439 \u0435\u0433\u043E \u043C\u044F\u0447\u043E\u043C,
      \u043F\u043E\u043A\u0430 \u043E\u043D \u0434\u0430\u043B\u0435\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398727
    m_Localized: "\u042E\u043B\u0430-\u0441\u043F\u0443\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398728
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u044E\u043B\u0430 \u0441
      \u0430\u043D\u0442\u0435\u043D\u043D\u0430\u043C\u0438. \u0412\u044B\u0431\u0438\u0442\u0430\u044F
      \u0440\u0430\u0441\u043F\u0430\u0434\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      \u0434\u0432\u0435 \u043C\u0438\u043D\u0438-\u044E\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398729
    m_Localized: "\u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0439 \u0435\u0451 \u0432
      \u0442\u043E\u043B\u043F\u0443, \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u0443\u044E
      \u044E\u043B\u0443, \u0438 \u043E\u0441\u0442\u0430\u0432\u044C \u043C\u044F\u0447\u0438
      \u043D\u0430 \u043C\u0438\u043D\u0438-\u044E\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398730
    m_Localized: "\u041A\u043E\u043D\u044C-\u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398731
    m_Localized: "\u0422\u0430\u0440\u0430\u043D\u0438\u0442, \u043A\u0430\u043A
      \u043B\u043E\u0448\u0430\u0434\u043A\u0430-\u043A\u0430\u0447\u0430\u043B\u043A\u0430,
      \u043D\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0437\u0430
      \u0441\u043E\u0431\u043E\u0439 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
      \u0441\u043B\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398732
    m_Localized: "\u041D\u0435 \u0441\u0442\u043E\u0439 \u043D\u0430 \u043B\u0438\u043D\u0438\u0438
      \u0442\u0430\u0440\u0430\u043D\u0430 \u0438 \u043D\u0435 \u0431\u0435\u0433\u0438
      \u043F\u043E \u0441\u043B\u0435\u0434\u0443. \u0420\u0430\u0441\u043A\u0430\u0447\u043A\u0443
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398733
    m_Localized: "\u041C\u0430\u043D\u0435\u043A\u0435\u043D \u0438\u0437 \u0443\u043D\u0438\u0432\u0435\u0440\u043C\u0430\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398734
    m_Localized: "\u0412 \u043A\u0440\u0430\u0441\u043D\u043E\u043C \u043F\u043B\u0430\u0442\u044C\u0435
      \u0438 \u0448\u043B\u044F\u043F\u043A\u0435. \u0417\u0430\u043C\u0438\u0440\u0430\u0435\u0442
      \u043F\u043E\u0434 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C, \u043A\u0430\u043A
      \u0432\u0441\u0435 \u043C\u0430\u043D\u0435\u043A\u0435\u043D\u044B, \u043D\u043E
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u2014 \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0439
      \u043C\u044F\u0447 \u0432 \u0441\u043F\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398735
    m_Localized: "\u041D\u0435 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F
      \u043A \u043D\u0435\u0439 \u0441\u043F\u0438\u043D\u043E\u0439. \u0421\u0438\u043B\u044C\u043D\u044B\u0439
      \u043C\u044F\u0447 \u0443\u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043B\u043E\u0432\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398736
    m_Localized: "\u0427\u0443\u0447\u0435\u043B\u043E \u0432 \u0443\u0448\u0430\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398737
    m_Localized: "\u0412 \u0432\u0430\u0442\u043D\u0438\u043A\u0435, \u0441 \u0433\u043E\u0440\u044F\u0449\u0438\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u041B\u043E\u0432\u0438\u0442
      \u0434\u0430\u0436\u0435 \u0437\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0435
      \u043C\u044F\u0447\u0438, \u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u0432\u0430
      \u0438 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u043C
      \u043A\u043E\u043B\u044E\u0447\u0438\u043C \u0451\u0436\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398738
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0431\u043E\u043A\u0443
      \u0438 \u0441\u0437\u0430\u0434\u0438. \u0415\u0433\u043E \u0451\u0436\u0438\u043A\u0430
      \u043D\u0435 \u043B\u043E\u0432\u0438 \u2014 \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398739
    m_Localized: "\u0422\u0435\u043D\u044C \u0432 \u0448\u043B\u044F\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398740
    m_Localized: "\u0422\u0435\u043D\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0433\u0430\u0441\u0438\u0442 \u0444\u043E\u043D\u0430\u0440\u0438, \u043C\u0438\u043C\u043E
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u0435\u0442,
      \u2014 \u0438 \u0441\u0432\u0435\u0442\u0430 \u043D\u0430 \u0430\u0440\u0435\u043D\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398741
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u0439 \u0435\u0451 \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u043E\u043C
      (Q) \u0438 \u0431\u0435\u0439 \u043D\u0430 \u0437\u0430\u043C\u0430\u0445\u0435,
      \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u043F\u043B\u043E\u0442\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398742
    m_Localized: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0434\u0432\u043E\u0440\u0430:
      \u0438\u0434\u0451\u0442 \u043D\u0430\u043F\u0440\u043E\u043B\u043E\u043C,
      \u0431\u044C\u0451\u0442 \u0442\u0435\u043B\u043E\u043C \u0438 \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445 \u043D\u0435\u0432\u0430\u043B\u044F\u0448\u0435\u043A.
      \u0412\u044B\u0431\u0438\u0442\u0430\u044F \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0435 \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435,
      \u0430 \u0442\u0435 \u2014 \u0435\u0449\u0451 \u043D\u0430 \u0434\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398743
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E
      \u0438 \u0441\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043A\u0430\u043C\u0438:
      \u043A\u043E\u0433\u0434\u0430 \u0438\u0445 \u0447\u0435\u0442\u044B\u0440\u0435,
      \u0432\u044B\u0431\u0438\u0432\u0430\u0439 \u043F\u043E \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398744
    m_Localized: "\u0411\u043E\u0441\u0441 \u0445\u043E\u043A\u043A\u0435\u0439\u043D\u043E\u0439
      \u043A\u043E\u0440\u043E\u0431\u043A\u0438. \u0411\u0440\u043E\u0441\u0430\u0435\u0442
      \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u043C\u044F\u0447\u0438 \u0438
      \u043A\u0430\u0436\u0434\u044B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u0432\u0438\u0441\u0442\u0438\u0442
      \u043D\u043E\u0432\u043E\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E:
      \xAB\u0417\u0430\u043C\u0440\u0438!\xBB, \xAB\u0428\u0442\u0440\u0430\u0444\u043D\u043E\u0439!\xBB,
      \xAB\u041C\u044F\u0447 \u0432 \u0438\u0433\u0440\u0435!\xBB \u0438\u043B\u0438
      \xAB\u0417\u0430\u043C\u0435\u043D\u0430!\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398745
    m_Localized: "\u0427\u0438\u0442\u0430\u0439 \u043F\u0440\u0430\u0432\u0438\u043B\u043E
      \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435: \u0432 \xAB\u0417\u0430\u043C\u0440\u0438!\xBB
      \u043D\u0435 \u0431\u0435\u0433\u0438, \u0432 \xAB\u0428\u0442\u0440\u0430\u0444\u043D\u043E\u0439!\xBB
      \u043B\u043E\u0432\u0438 \u0432\u0435\u0435\u0440 (\u043A\u0440\u043E\u043C\u0435
      \u0451\u0436\u0438\u043A\u043E\u0432), \u043E\u0442 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0433\u043E
      \u043C\u044F\u0447\u0430 \u0443\u0445\u043E\u0434\u0438 \u0440\u044B\u0432\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398746
    m_Localized: "\u041C\u0438\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0435
      \xAB\u0416\u0438\u0433\u0443\u043B\u0438\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432
      \u0440\u043E\u0431\u043E\u0442\u0430. \u041C\u0430\u0448\u0438\u043D\u043E\u0439
      \u0442\u0430\u0440\u0430\u043D\u0438\u0442 \u0438 \u0441\u043D\u043E\u0441\u0438\u0442
      \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0438, \u0440\u043E\u0431\u043E\u0442\u043E\u043C
      \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u0432\u0435\u0435\u0440\u043E\u043C
      \u0438 \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0438-\u043C\u0438\u043D\u044B,
      \u0437\u043E\u0432\u0451\u0442 \u043C\u0430\u0448\u0438\u043D\u043A\u0438 \u043D\u0430
      \u043F\u0443\u043B\u044C\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398747
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u044C \u0435\u0433\u043E \u0432\u0440\u0435\u0437\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0441\u0442\u0435\u043D\u0443 \u2014 \u043E\u0433\u043B\u0443\u0448\u0451\u043D\u043D\u044B\u0439,
      \u043E\u043D \u043E\u0442\u043A\u0440\u044B\u0442. \u0411\u0435\u0439, \u043F\u043E\u043A\u0430
      \u043E\u043D \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043B\u043F\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398748
    m_Localized: "\u0421\u043A\u0430\u0447\u0435\u0442 \u0437\u0430 \u0442\u043E\u0431\u043E\u0439
      \u0438 \u0431\u044C\u0451\u0442 \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0435\u043C
      \u043F\u043E \u043A\u0440\u0443\u0433\u0443, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u043E\u0431\u043B\u0430\u043A\u0430 \u0432\u0430\u0442\u044B, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0432\u044F\u0437\u043D\u0435\u0448\u044C. \u0411\u0440\u043E\u0441\u0430\u0435\u0442
      \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0443-\u0431\u0443\u043C\u0435\u0440\u0430\u043D\u0433,
      \u0432\u0431\u043B\u0438\u0437\u0438 \u0445\u043B\u0435\u0449\u0435\u0442 \u0443\u0448\u0430\u043C\u0438,
      \u0430 \u043D\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 \u0436\u0438\u0437\u043D\u0438
      \u0443 \u043D\u0435\u0433\u043E \u0440\u0432\u0451\u0442\u0441\u044F \u0448\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398749
    m_Localized: "\u0423\u0445\u043E\u0434\u0438 \u0438\u0437 \u043A\u0440\u0443\u0433\u0430
      \u0434\u043E \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u044F
      \u2014 \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u044B\u0436\u043A\u0430
      \u043E\u043D \u0441\u0438\u0434\u0438\u0442 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439.
      \u041E\u0431\u0445\u043E\u0434\u0438 \u043E\u0431\u043B\u0430\u043A\u0430 \u0432\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398750
    m_Localized: "\u0411\u0430\u0431\u0430\u0439 \u0441 \u043C\u0435\u0448\u043A\u043E\u043C.
      \u041B\u043E\u0432\u0438\u0442 \u0432\u0441\u0435 \u043C\u044F\u0447\u0438
      \u0441\u043F\u0435\u0440\u0435\u0434\u0438 \u0438 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
      \u0432\u0435\u0435\u0440\u043E\u043C, \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
      \u0447\u0443\u0436\u0438\u0435 \u043C\u044F\u0447\u0438 \u0432 \u043C\u0435\u0448\u043E\u043A,
      \u0433\u0430\u0441\u0438\u0442 \u0441\u0432\u0435\u0442, \u0437\u043E\u0432\u0451\u0442
      \u0432\u043E\u0440\u043E\u043D, \u043F\u0440\u044B\u0433\u0430\u0435\u0442
      \u043D\u0430 \u0448\u0435\u0441\u0442\u0435, \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F
      \u0441\u0440\u0435\u0434\u0438 \u0447\u0443\u0447\u0435\u043B \u0438 \u0441\u0447\u0438\u0442\u0430\u0435\u0442
      \u0434\u043E \u043F\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1455588243398751
    m_Localized: "\u0411\u0435\u0439 \u0441\u0431\u043E\u043A\u0443 \u0438 \u0441\u0437\u0430\u0434\u0438
      \u2014 \u043E\u043D \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435
      \u0432 \u043C\u0435\u0448\u043E\u043A \u0432\u044B\u0441\u044B\u043F\u0430\u0435\u0442
      \u043C\u044F\u0447\u0438, \u043D\u0430 \xAB\u0421\u0447\u0438\u0442\u0430\u043B\u043E\u0447\u043A\u0443\xBB
      \u043F\u0440\u044F\u0447\u044C\u0441\u044F \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u0438\u0435.
      \u0410 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u0434\u043E
      \u0437\u043E\u0432\u0430 \u043C\u0430\u043C\u044B."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
