    m_Metadata:
      m_Items: []
  - m_Id: 194562264915971
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915972
    m_Localized: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0442\u0435\u0431\u044F \u0441\u0432\u0435\u0442\u043B\u0435\u0435. \u0412
      \u044D\u0442\u043E\u043C \u0441\u0432\u0435\u0442\u0435 \u0442\u0435\u043D\u044C
      \u0442\u0432\u0451\u0440\u0434\u0430\u044F \u2014 \u043F\u043E \u043D\u0435\u0439
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043F\u0430\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915973
    m_Localized: "\u0421\u0432\u0438\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915974
    m_Localized: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043B\u043E\u0432\u043B\u044F
      \u2014 \u0438 \u0432\u0440\u0430\u0433\u0438 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0437\u0430\u043C\u0438\u0440\u0430\u044E\u0442 \u043D\u0430 \u043F\u043E\u043B\u0442\u043E\u0440\u044B
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915975
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915976
    m_Localized: "\u0420\u0430\u0437 \u0437\u0430 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0443
      \u0443\u0434\u0430\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B\u0431\u0438\u043B
      \u0431\u044B \u0442\u0435\u0431\u044F, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043E\u0434\u043D\u043E \u0441\u0435\u0440\u0434\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915977
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u044B \u043F\u0438\u0440\u043E\u0436\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915978
    m_Localized: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0430\u0440\u0435\u043D\u044B
      +1 \u0441\u0435\u0440\u0434\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915979
    m_Localized: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u0441\u0430\u043F\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915980
    m_Localized: "\u041F\u0435\u0441\u043E\u043A \u0438 \u043B\u0443\u0436\u0438
      \u0442\u0435\u0431\u044F \u043D\u0435 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915981
    m_Localized: "\u041F\u0440\u044B\u0433\u0430\u044E\u0449\u0430\u044F \u0431\u043E\u043C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915982
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0430\u044F \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0430
      + \u041F\u043E\u043F\u0440\u044B\u0433\u0443\u043D\u0447\u0438\u043A. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043E\u0442\u0441\u043A\u043E\u043A \u043C\u044F\u0447\u0430 \u043E\u0442
      \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430 \u2014 \u0432\u0437\u0440\u044B\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915983
    m_Localized: "\u0413\u0440\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915984
    m_Localized: "\u0422\u0435\u043D\u043D\u0438\u0441\u043D\u044B\u0435 \u043C\u044F\u0447\u0438
      + \u0420\u0430\u0437\u0434\u0432\u043E\u0435\u043D\u0438\u0435. \u041C\u044F\u0447\u0438
      \u0432\u0435\u0435\u0440\u0430 \u0438 \u0434\u0432\u043E\u0439\u043D\u0438\u043A\u0438
      \u0442\u043E\u0436\u0435 \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915985
    m_Localized: "\u0413\u0438\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915986
    m_Localized: "\u041D\u0430\u0431\u0438\u0432\u043D\u043E\u0439 \u043C\u044F\u0447
      + \u0425\u0443\u043B\u0438\u0433\u0430\u043D\u0441\u0442\u0432\u043E. \u0423\u0434\u0430\u0440
      \u043F\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442
      \u0432\u0441\u0435\u0445 \u0437\u0430\u0434\u0435\u0442\u044B\u0445 \u043D\u0430
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915987
    m_Localized: "\u041A\u0443\u0432\u044B\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915988
    m_Localized: "\u041F\u043E\u0434\u043A\u0430\u0442 + \u0421\u043A\u0430\u043A\u0430\u043B\u043A\u0430.
      \u0420\u044B\u0432\u043E\u043A \u0441\u043A\u0432\u043E\u0437\u044C \u043C\u044F\u0447
      \u0432\u0440\u0430\u0433\u0430 \u043B\u043E\u0432\u0438\u0442 \u0435\u0433\u043E
      \u2014 \u0434\u0430\u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915989
    m_Localized: "\u0428\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915990
    m_Localized: "\u0412 \u043A\u0430\u0436\u0434\u043E\u043C \u043B\u0430\u0440\u044C\u043A\u0435
