  m_TableData:
  - m_Id: 153544024064
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u043D\u0435\u0432\u0430\u043B\u044F\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412672
    m_Localized: "\u041D\u0430\u0431\u0438\u0432\u043D\u043E\u0439 \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412673
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439: 2 \u0443\u0440\u043E\u043D\u0430
      (\u0437\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439 \u2014 3) \u0438
      1 \u0443\u0440\u043E\u043D \u0432\u0441\u0435\u043C \u0432 2,6 \u043C \u043E\u0442
      \u0446\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412674
    m_Localized: "\u0422\u0435\u043D\u043D\u0438\u0441\u043D\u044B\u0435 \u043C\u044F\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412675
    m_Localized: "\u041B\u0435\u0442\u044F\u0442 \u0432\u0435\u0435\u0440\u043E\u043C
      \u043F\u043E \u0442\u0440\u0438. \u0414\u0432\u0430 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442 \u043D\u0430 \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412676
    m_Localized: "\u0412\u043E\u043B\u0435\u0439\u0431\u043E\u043B\u044C\u043D\u044B\u0439
      \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412677
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
      \u043F\u0435\u0440\u0435\u043B\u0435\u0442\u0430\u0435\u0442 \u0435\u0449\u0451
      \u0432 2 \u0432\u0440\u0430\u0433\u043E\u0432 \u043F\u043E\u0434\u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412678
    m_Localized: "\u0411\u0443\u043C\u0435\u0440\u0430\u043D\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412679
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 0,35 \u0441 \u043F\u043E\u043B\u0451\u0442\u0430
      \u043C\u044F\u0447 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0442\u0435\u0431\u0435 \u0438 \u0441\u0431\u0438\u0432\u0430\u0435\u0442
      \u0432\u0441\u0435\u0445 \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 153552412680
    m_Localized: "\u041D\u0430 \u0440\u0435\u0437\u0438\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153552412681
    m_Localized: "\u0422\u0432\u043E\u0439 \u0443\u043F\u0430\u0432\u0448\u0438\u0439
      \u043C\u044F\u0447 \u0441\u0430\u043C \u043F\u0440\u044B\u0433\u0430\u0435\u0442
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606976
    m_Localized: "\u0415\u0449\u0451 \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606977
    m_Localized: "+1 \u0441\u0432\u043E\u0439 \u043C\u044F\u0447 \u2014 \u0432 \u0440\u0443\u043A\u0438
      \u0438 \u0432 \u0437\u0430\u043F\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606978
    m_Localized: "\u0420\u0430\u0437\u0434\u0432\u043E\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606979
    m_Localized: "\u041F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u043C \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438
      \u043C\u044F\u0447 \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0430 \u0434\u0432\u043E\u0439\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606980
    m_Localized: "\u0426\u0435\u043F\u043A\u0438\u0435 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606981
    m_Localized: "\u041E\u043A\u043D\u043E \u043B\u043E\u0432\u043B\u0438 \u043D\u0430
      35% \u0434\u043B\u0438\u043D\u043D\u0435\u0435, \u043B\u043E\u0432\u0438\u0448\u044C
      \u0447\u0443\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435. \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u2014 \u0442\u043E\u0442 \u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606982
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606983
    m_Localized: "\u041F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0448\u044C \u043C\u044F\u0447\u0438
      \u0438 \u043C\u043E\u043D\u0435\u0442\u043A\u0438 \u043D\u0430 50% \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606984
    m_Localized: "\u041D\u043E\u0432\u044B\u0435 \u043A\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606985
    m_Localized: "\u0411\u0435\u0433\u0430\u0435\u0448\u044C \u043D\u0430 12% \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 153556606986
    m_Localized: "\u0411\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 153556606987
    m_Localized: "+1 \u0436\u0438\u0437\u043D\u044C. \u0411\u0430\u0431\u0443\u0448\u043A\u0430
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 23928708784128
    m_Localized: "\u041F\u043E\u043F\u0440\u044B\u0433\u0443\u043D\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978432
    m_Localized: "\u041A\u043E\u0441\u043D\u0443\u0432\u0448\u0438\u0441\u044C \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430,
      \u043C\u044F\u0447 \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 1 \u043C \u0438 \u0441\u043D\u043E\u0432\u0430 \u043E\u043F\u0430\u0441\u0435\u043D.
      +1 \u043E\u0442\u0441\u043A\u043E\u043A \u0437\u0430 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978433
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0430\u044F \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978434
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043B\u043E\u0432\u043B\u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0431\u0440\u043E\u0441\u043E\u043A \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F:
      2 \u0443\u0440\u043E\u043D\u0430 \u0432\u0441\u0435\u043C \u0432 3 \u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978435
    m_Localized: "\u0416\u0432\u0430\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978436
    m_Localized: "\u041C\u044F\u0447 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043B\u0438\u043F\u043A\u0438\u0439 \u0440\u043E\u0437\u043E\u0432\u044B\u0439
      \u0441\u043B\u0435\u0434: \u0432\u0440\u0430\u0433\u0438 \u0432 \u043D\u0451\u043C
      \u0432\u044F\u0437\u043D\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978437
    m_Localized: "\u041F\u043E\u0434\u043A\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978438
    m_Localized: "\u0420\u044B\u0432\u043E\u043A \u0441\u0431\u0438\u0432\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0441 \u043D\u043E\u0433 \u0438 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442
      \u043D\u0430 0,8 \u0441. \u0411\u0435\u0437 \u0443\u0440\u043E\u043D\u0430,
      \u043D\u0435 \u0447\u0430\u0449\u0435 \u0440\u0430\u0437\u0430 \u0432 0,8 \u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978439
    m_Localized: "\u0425\u0443\u043B\u0438\u0433\u0430\u043D\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978440
    m_Localized: "+1 \u0443\u0440\u043E\u043D \u043A\u0430\u0436\u0434\u043E\u043C\u0443
      \u0431\u0440\u043E\u0441\u043A\u0443 (\u0434\u0432\u043E\u0439\u043D\u0438\u043A\u0430\u043C
      \u2014 \u043D\u0435\u0442), \u043D\u043E \u043D\u0430 \u043E\u0434\u0438\u043D
      \u043C\u044F\u0447 \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978441
    m_Localized: "\u0417\u0430\u043C\u0440\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978442
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u0443\u0434\u0430\u0447\u043D\u0430\u044F
      \u043B\u043E\u0432\u043B\u044F \u043D\u0430 1 \u0441 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442
      \u0432\u0441\u0451 \u0432\u043E\u043A\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978443
    m_Localized: "\u0421\u0434\u0443\u0442\u044B\u0439 \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 23928712978444
    m_Localized: "\u041B\u0435\u0442\u0438\u0442 \u0437\u043C\u0435\u0439\u043A\u043E\u0439
      \u0438 \u0437\u0430\u0434\u0435\u0432\u0430\u0435\u0442 \u0432\u0441\u0435\u0445
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0432 0,8 \u043C \u043E\u0442 \u043F\u0443\u0442\u0438.
      \u0421\u0432\u0435\u0447\u043A\u043E\u0439 \u043D\u0435 \u043E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509120
    m_Localized: "\u0421\u0442\u0435\u043D\u043E\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509121
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0438\u043A\u043E\u0448\u0435\u0442
      \u043E\u0442 \u0441\u0442\u0435\u043D\u044B: +1 \u0443\u0440\u043E\u043D \u044D\u0442\u043E\u043C\u0443
      \u0431\u0440\u043E\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509122
    m_Localized: "\u0420\u043E\u0433\u0430\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509123
    m_Localized: "\u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439 \u0431\u0440\u043E\u0441\u043E\u043A
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u0432\u0441\u0435\u0445
      \u0432\u0440\u0430\u0433\u043E\u0432 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509124
    m_Localized: "\u0413\u043B\u0430\u0437-\u0430\u043B\u043C\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509125
    m_Localized: "\u041C\u044F\u0447 \u0434\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u0432\u0440\u0430\u0433\u0443
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 (\u0434\u043E 14 \u043C). \u0414\u0432\u043E\u0439\u043D\u0438\u043A\u0438
      \u2014 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509126
    m_Localized: "\u0414\u043E\u043C\u0438\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509127
    m_Localized: "\u0412\u044B\u0431\u0438\u0442\u044B\u0439 \u0432\u0440\u0430\u0433
      \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u0435\u0439
      \u0432 2,3 \u043C: 1 \u0443\u0440\u043E\u043D \u2014 \u0438 \u0442\u0430\u043A
      \u043F\u043E \u0446\u0435\u043F\u043E\u0447\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509128
    m_Localized: "\u041A\u043E\u043F\u0438\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509129
    m_Localized: "\u0423 \u043B\u0430\u0440\u044C\u043A\u0430: +1 \u043C\u043E\u043D\u0435\u0442\u043A\u0430
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 10 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435.
      \u041D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043A\u0430\u0440\u043C\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509130
    m_Localized: "\u041A\u0440\u044B\u0448\u043A\u0430 \u043E\u0442 \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509131
    m_Localized: "\u0420\u0430\u0437 \u0432 20 \u0441 \u043E\u0442\u0431\u0438\u0432\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D \u0443\u0434\u0430\u0440 \u0438\u043B\u0438 \u043C\u044F\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509132
    m_Localized: "\u0419\u043E-\u0439\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 133956933509133
    m_Localized: "\u0411\u0443\u043C\u0435\u0440\u0430\u043D\u0433 + \u041D\u0430
      \u0440\u0435\u0437\u0438\u043D\u043A\u0435. \u041E\u0434\u0438\u043D \u043C\u044F\u0447
      \u043D\u0430 \u043D\u0438\u0442\u043A\u0435: \u043F\u043E\u0441\u043B\u0435
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0441\u0430\u043C \u043B\u0435\u0442\u0438\u0442
      \u0432 \u0440\u0443\u043A\u0438 \u0438 \u0441\u0431\u0438\u0432\u0430\u0435\u0442
      \u0432\u0441\u0435\u0445 \u043D\u0430 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 194562260721664
    m_Localized: "\u0421\u043A\u0430\u043A\u0430\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915968
    m_Localized: "\u0420\u044B\u0432\u043E\u043A \u043D\u0430 30% \u0434\u0430\u043B\u044C\u0448\u0435
      \u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 20% \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915969
    m_Localized: "\u0417\u0435\u0440\u043A\u0430\u043B\u044C\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 194562264915970
    m_Localized: "\u041C\u0430\u043D\u0435\u043A\u0435\u043D\u044B \u0437\u0430\u043C\u0438\u0440\u0430\u044E\u0442
      \u0438 \u0443 \u0442\u0435\u0431\u044F \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439."
