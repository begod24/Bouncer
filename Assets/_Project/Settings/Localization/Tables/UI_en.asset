    m_Localized: Leave
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160462
    m_Localized: "Click or Enter \u2014 buy    L \u2014 hold    R \u2014 reroll   
      Esc \u2014 leave\nGamepad: A \u2014 buy    X \u2014 hold    Y \u2014 reroll   
      B \u2014 leave"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160463
    m_Localized: Not enough coins
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160464
    m_Localized: 'Piggy bank: +{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160465
