    m_Metadata:
      m_Items: []
  - m_Id: 155645370388
    m_Localized: "WASD \u2014 run    mouse \u2014 aim    LMB \u2014 throw (hold to
      charge)\nRMB / E \u2014 catch    Space / Shift \u2014 dash    F \u2014 newsstand   
      Esc \u2014 pause\nGamepad: left stick, right stick, RT \u2014 throw, LT \u2014
      catch, A \u2014 dash, X \u2014 newsstand\nH \u2014 hide hints"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370390
    m_Localized: Pick a gum card
    m_Metadata:
      m_Items: []
