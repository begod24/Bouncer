    m_Metadata:
      m_Items: []
  - m_Id: 155645370395
    m_Localized: "\u0413\u041E\u0421\u0422\u0418\u041D\u0415\u0426"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370396
    m_Localized: "\u041D\u0410\u0421\u0422\u0420\u041E\u0419\u041A\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370397
    m_Localized: "\u0418\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370398
    m_Localized: "\u0412\u0438\u0434\u0435\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370399
    m_Localized: "\u0417\u0432\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370400
    m_Localized: "\u042F\u0437\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370401
    m_Localized: "\u041E\u0431\u0449\u0430\u044F \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370402
    m_Localized: "\u041C\u0443\u0437\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370403
    m_Localized: "\u0417\u0432\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370404
    m_Localized: "\u0420\u0435\u0436\u0438\u043C \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370405
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370406
    m_Localized: "\u0412\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F
      \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370407
    m_Localized: "\u0422\u0440\u044F\u0441\u043A\u0430 \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370408
    m_Localized: "\u0410\u0432\u0442\u043E\u043F\u0440\u0438\u0446\u0435\u043B: \u043C\u044B\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370409
    m_Localized: "\u0410\u0432\u0442\u043E\u043F\u0440\u0438\u0446\u0435\u043B: \u0433\u0435\u0439\u043C\u043F\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370410
    m_Localized: "\u041B\u0438\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370411
    m_Localized: "\u042F\u0437\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370412
    m_Localized: "\u0432\u043A\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370413
    m_Localized: "\u0432\u044B\u043A\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370414
    m_Localized: "\u0432 \u043E\u043A\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370415
    m_Localized: "\u043F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370416
    m_Localized: "\u2039 \u203A \u2014 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C   
      Q / E, LB / RB \u2014 \u0432\u043A\u043B\u0430\u0434\u043A\u0438    Esc / B
      \u2014 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370417
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370418
    m_Localized: "\u0410\u0412\u0422\u041E\u0420\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370419
    m_Localized: "\u0410\u0432\u0442\u043E\u0440 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370420
    m_Localized: "\u0428\u0440\u0438\u0444\u0442\u044B Neucha \u0438 Caveat \u2014
      SIL Open Font License"
    m_Metadata:
      m_Items: []
  - m_Id: 1931966668800
    m_Localized: "Esc / B \u2014 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 133958216966144
    m_Localized: "\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u0432\u043A\u043B\u0430\u0434\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160448
    m_Localized: "\u041F\u043E\u0440\u0442\u0444\u0435\u043B\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160449
    m_Localized: "\u0422\u0440\u043E\u0444\u0435\u0439 \u0437\u0430 \u0431\u043E\u0441\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160450
    m_Localized: "\u041A\u041E\u041C\u0411\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160451
    m_Localized: "\u0420\u0415\u0414\u041A\u0410\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160452
    m_Localized: "\u0417\u041E\u041B\u041E\u0422\u0410\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160453
    m_Localized: "\u0421\u041E\u042E\u0417\u041F\u0415\u0427\u0410\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160454
    m_Localized: "\u0416\u0432\u0430\u0447\u043A\u0438 \u0441 \u0432\u043A\u043B\u0430\u0434\u044B\u0448\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160455
    m_Localized: "\u041F\u0420\u041E\u0414\u0410\u041D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160456
    m_Localized: "\u041E\u0442\u043B\u043E\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160457
    m_Localized: "\u041E\u0442\u043B\u043E\u0436\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160458
    m_Localized: "\u041F\u0435\u0440\u0435\u0431\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160459
    m_Localized: "\u041B\u0438\u043C\u043E\u043D\u0430\u0434: +1 \u0441\u0435\u0440\u0434\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160460
    m_Localized: "\u0411\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434: \u0432\u0441\u0435
      \u0441\u0435\u0440\u0434\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160461
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160462
    m_Localized: "\u041A\u043B\u0438\u043A \u0438\u043B\u0438 Enter \u2014 \u043A\u0443\u043F\u0438\u0442\u044C   
      L \u2014 \u043E\u0442\u043B\u043E\u0436\u0438\u0442\u044C    R \u2014 \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0442\u044C   
      Esc \u2014 \u0443\u0439\u0442\u0438\n\u0413\u0435\u0439\u043C\u043F\u0430\u0434:
      A \u2014 \u043A\u0443\u043F\u0438\u0442\u044C    X \u2014 \u043E\u0442\u043B\u043E\u0436\u0438\u0442\u044C   
      Y \u2014 \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0442\u044C    B \u2014
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160463
    m_Localized: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043C\u043E\u043D\u0435\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160464
    m_Localized: "\u041A\u043E\u043F\u0438\u043B\u043A\u0430: +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160465
    m_Localized: "{0} \u2014 \u043B\u0430\u0440\u0451\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160466
    m_Localized: "\u041B\u0430\u0440\u0451\u043A \u043E\u0442\u043A\u0440\u044B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160467
    m_Localized: "\u041F\u0420\u041E\u0419\u0414\u0415\u041D\u041E!"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160468
    m_Localized: "\u0417\u0430\u0433\u043B\u044F\u043D\u0438 \u0432 \u043B\u0430\u0440\u0451\u043A,
      \u043F\u043E\u0442\u043E\u043C \u2014 \u043A \u0441\u0442\u0440\u0435\u043B\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160469
    m_Localized: "\u0414\u0432\u043E\u0440 \xB7 \u0443\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160470
    m_Localized: "\u0414\u0432\u043E\u0440 \xB7 \u0432\u0435\u0447\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 133958221160471
    m_Localized: "\u0414\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262272
    m_Localized: "\u0425\u043E\u043A\u043A\u0435\u0439\u043D\u0430\u044F \u043A\u043E\u0440\u043E\u0431\u043A\u0430
      \xB7 \u0432\u0435\u0447\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262273
    m_Localized: "\u0421\u0442\u0440\u043E\u0439\u043A\u0430 \xB7 \u0441\u0443\u043C\u0435\u0440\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262274
    m_Localized: "\u0412 \u043A\u043E\u0440\u043E\u0431\u043A\u0443 \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262275
    m_Localized: "\u041D\u0430 \u0441\u0442\u0440\u043E\u0439\u043A\u0443 \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262276
    m_Localized: "\u0417\u0410\u041C\u0420\u0418!"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262277
    m_Localized: "\u041A\u0442\u043E \u043F\u043E\u0431\u0435\u0436\u0438\u0442 \u2014
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u043C\u044F\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262278
    m_Localized: "\u0428\u0422\u0420\u0410\u0424\u041D\u041E\u0419!"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262279
    m_Localized: "\u041B\u043E\u0432\u0438, \u0447\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262280
    m_Localized: "\u041C\u042F\u0427 \u0412 \u0418\u0413\u0420\u0415!"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262281
    m_Localized: "\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u043C\u044F\u0447
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0432\u0441\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262282
    m_Localized: "\u0417\u0410\u041C\u0415\u041D\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262283
    m_Localized: "\u0421\u043E \u0441\u043A\u0430\u043C\u0435\u0439\u043A\u0438 \u0431\u0435\u0436\u0438\u0442
      \u043F\u043E\u0434\u043C\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262284
    m_Localized: "\u0414\u043E\u0436\u0434\u044C: \u0432 \u043B\u0443\u0436\u0430\u0445
      \u043C\u044F\u0447 \u0433\u0430\u0441\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262285
    m_Localized: "\u0413\u0440\u043E\u0437\u0430: \u043C\u043E\u043B\u043D\u0438\u044F
      \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442 \u0432\u0441\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 194564366262286
    m_Localized: "\u0422\u0443\u043C\u0430\u043D: \u0432\u0438\u0434\u043D\u043E
      \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 377581583982592
    m_Localized: "\u0414\u0432\u043E\u0440 \xB7 \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371200
    m_Localized: "\u041F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C, \u043F\u043E\u043A\u0430
      \u043C\u0430\u043C\u0430 \u043D\u0435 \u043F\u043E\u0437\u043E\u0432\u0451\u0442
      \u0434\u043E\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371201
    m_Localized: "\u0414\u043E\u043C\u043E\u0439 \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371202
    m_Localized: "\u0414\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371203
    m_Localized: "\u041C\u0415\u0428\u041E\u041A!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371204
    m_Localized: "\u041F\u043E\u043F\u0430\u0434\u0438 \u0432 \u043C\u0435\u0448\u043E\u043A
      \u0441\u0437\u0430\u0434\u0438 \u2014 \u043C\u044F\u0447\u0438 \u0432\u044B\u0441\u044B\u043F\u043B\u044E\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371205
    m_Localized: "\u0412\u041E\u0420\u041E\u041D\u042C\u0401!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371206
    m_Localized: "\u0422\u0435\u043D\u044C \u043D\u0430 \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0435
      \u2014 \u044D\u0442\u043E \u0432\u043E\u0440\u043E\u043D\u0430. \u0421\u0431\u0435\u0439
      \u0435\u0451 \u043C\u044F\u0447\u043E\u043C, \u043A\u043E\u0433\u0434\u0430
      \u0441\u043F\u0438\u043A\u0438\u0440\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371207
    m_Localized: "\u041A\u0410\u0420\u0423\u0421\u0415\u041B\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371208
    m_Localized: "\u041B\u043E\u0432\u0438 \u043C\u044F\u0447\u0438 \u2014 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F
      \u043B\u043E\u0432\u043B\u044F \u043B\u0435\u0447\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371209
    m_Localized: "\u0420\u0410\u0417, \u0414\u0412\u0410, \u0422\u0420\u0418, \u0427\u0415\u0422\u042B\u0420\u0415,
      \u041F\u042F\u0422\u042C..."
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371210
    m_Localized: "\u0421\u043F\u0440\u044F\u0447\u044C\u0441\u044F \u0437\u0430 \u0440\u0430\u043A\u0435\u0442\u043E\u0439,
      \u043B\u0430\u0440\u044C\u043A\u043E\u043C \u0438\u043B\u0438 \u043A\u0430\u0447\u0435\u043B\u044F\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371211
    m_Localized: "\u042F \u0418\u0414\u0423 \u0418\u0421\u041A\u0410\u0422\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371212
    m_Localized: "\u0413\u0410\u0421\u0418\u0422 \u0421\u0412\u0415\u0422!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371213
    m_Localized: "\u0418\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u043B\u0435\u0437\u0443\u0442
      \u0442\u0435\u043D\u0438: \u0442\u0432\u0451\u0440\u0434\u044B\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u0430 \u0437\u0430\u043C\u0430\u0445\u0438\u0432\u0430\u044E\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371214
    m_Localized: "\u041F\u0420\u042F\u0422\u041A\u0418!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371215
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0432\u044B\u0434\u0430\u044E\u0442
      \u0433\u043E\u0440\u044F\u0449\u0438\u0435 \u0433\u043B\u0430\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371216
    m_Localized: "\u041C\u0410\u041C\u0410 \u0417\u041E\u0412\u0401\u0422 \u0414\u041E\u041C\u041E\u0419!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371217
    m_Localized: "\u0411\u0435\u0433\u0438 \u043A \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0443
      \u2014 \u0432 \u0441\u0432\u0435\u0442 \u0438\u0437 \u0434\u0432\u0435\u0440\u0438
      \u043E\u043D \u043D\u0435 \u0441\u0443\u043D\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371218
    m_Localized: "\xAB\u0422\u043E\u0442, \u043A\u0442\u043E \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445\xBB
      \u0432\u044B\u0431\u0438\u0442. \u0411\u0435\u0433\u0438 \u0434\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371219
    m_Localized: "\u0434\u043E \u0437\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371220
    m_Localized: "\u0414\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 441339446550528
    m_Localized: "\u041A\u0422\u041E \u0412\u042B\u0425\u041E\u0414\u0418\u0422 \u0413\u0423\u041B\u042F\u0422\u042C?"
    m_Metadata:
      m_Items: []
  - m_Id: 441339446550529
    m_Localized: "\u2190/\u2192 \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C,
      Enter / A \u2014 \u0433\u0443\u043B\u044F\u0442\u044C, Esc / B \u2014 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
