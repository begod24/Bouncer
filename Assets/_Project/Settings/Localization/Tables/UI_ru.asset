  - m_Id: 1455588415365126
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u043A\u0438 / \u0441\u0442\u0438\u043A
      \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C    \u2190/\u2192 \u2014 \u0440\u0430\u0437\u0434\u0435\u043B   
      Q / E, LB / RB \u2014 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430    Esc
      / B \u2014 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
