  m_TableData:
  - m_Id: 155641176064
    m_Localized: "\u0412\u042B\u0428\u0418\u0411\u0410\u041B\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370368
    m_Localized: "\u0434\u0432\u043E\u0440\u043E\u0432\u044B\u0435 \u0432\u044B\u0448\u0438\u0431\u0430\u043B\u044B
      \u043F\u0440\u043E\u0442\u0438\u0432 \u043E\u0436\u0438\u0432\u0448\u0438\u0445
      \u0438\u0433\u0440\u0443\u0448\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370369
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370370
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370371
    m_Localized: "\u0410\u0432\u0442\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370372
    m_Localized: "\u0412\u044B\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370373
    m_Localized: "\u043C\u044B\u0448\u044C, \u0441\u0442\u0440\u0435\u043B\u043A\u0438
      + Enter \u0438\u043B\u0438 \u0433\u0435\u0439\u043C\u043F\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370374
    m_Localized: "\u041F\u0410\u0423\u0417\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370375
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370376
    m_Localized: "\u0417\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370377
    m_Localized: "\u0412 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370378
    m_Localized: "Esc \u2014 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370379
    m_Localized: "\u0412\u042B\u0411\u0418\u0422!"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370380
    m_Localized: "\u0415\u0449\u0451 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370381
    m_Localized: "R / Start \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370382
    m_Localized: "\u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F
      {0}    \u0432\u044B\u0431\u0438\u0442\u043E: {1}    \u043A\u0430\u0440\u0442\u043E\u0447\u0435\u043A:
      {2}    \u043C\u043E\u043D\u0435\u0442\u043E\u043A: {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370383
    m_Localized: "\u0414\u0412\u041E\u0420 \u041D\u0410\u0428!"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370384
    m_Localized: "\u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0430 \u0437\u0430 {0}   
      \u0432\u044B\u0431\u0438\u0442\u043E: {1}    \u043A\u0430\u0440\u0442\u043E\u0447\u0435\u043A:
      {2}    \u043C\u043E\u043D\u0435\u0442\u043E\u043A: {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370386
    m_Localized: "\u0432\u044B\u0431\u0438\u0442\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370387
    m_Localized: "\u0421\u0412\u0415\u0427\u041A\u0410! \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0431\u0440\u043E\u0441\u043E\u043A \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370388
    m_Localized: "WASD \u2014 \u0431\u0435\u0433    \u043C\u044B\u0448\u044C \u2014
      \u043F\u0440\u0438\u0446\u0435\u043B    \u041B\u041A\u041C \u2014 \u0431\u0440\u043E\u0441\u043E\u043A
      (\u0434\u0435\u0440\u0436\u0438 \u2014 \u0437\u0430\u0440\u044F\u0434)    Q
      \u2014 \u0444\u043E\u043D\u0430\u0440\u0438\u043A \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435\n\u041F\u041A\u041C
      / E \u2014 \u043B\u043E\u0432\u043B\u044F \u0438\u043B\u0438 \u0445\u0432\u0430\u0442
      \u043C\u044F\u0447\u0430 \u0440\u044F\u0434\u043E\u043C    Space / Shift \u2014
      \u0440\u044B\u0432\u043E\u043A    F \u2014 \u043B\u0430\u0440\u0451\u043A   
      Tab \u2014 \u043A\u0430\u0440\u043C\u0430\u043D\u044B    Esc \u2014 \u043F\u0430\u0443\u0437\u0430\n\u0413\u0435\u0439\u043C\u043F\u0430\u0434:
      \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A, \u043F\u0440\u0430\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A, RT \u2014 \u0431\u0440\u043E\u0441\u043E\u043A, LT
      \u2014 \u043B\u043E\u0432\u043B\u044F, A \u2014 \u0440\u044B\u0432\u043E\u043A,
      LB \u2014 \u0444\u043E\u043D\u0430\u0440\u0438\u043A, X \u2014 \u043B\u0430\u0440\u0451\u043A,
      Select \u2014 \u043A\u0430\u0440\u043C\u0430\u043D\u044B\nH \u2014 \u0441\u043A\u0440\u044B\u0442\u044C
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370390
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0432\u043A\u043B\u0430\u0434\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370391
    m_Localized: "\u041C\u044B\u0448\u044C, \u0441\u0442\u0440\u0435\u043B\u043A\u0438
      + Enter, \u0433\u0435\u0439\u043C\u043F\u0430\u0434 \u2014 \u0438\u043B\u0438
      \u043A\u043B\u0430\u0432\u0438\u0448\u0438 1 \xB7 2 \xB7 3"
    m_Metadata:
      m_Items: []
  - m_Id: 155645370392
