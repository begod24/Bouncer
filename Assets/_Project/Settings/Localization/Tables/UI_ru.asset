      m_Items: []
  - m_Id: 1455588411170826
    m_Localized: "\u041F\u043E\u0431\u0435\u0433\u0430\u0439 \u043F\u043E \u0434\u0432\u043E\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170827
    m_Localized: "WASD \u0438\u043B\u0438 \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170828
    m_Localized: "\u0412\u044B\u0431\u0435\u0439 \u043D\u0435\u0432\u0430\u043B\u044F\u0448\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170829
    m_Localized: "\u0426\u0435\u043B\u044C\u0441\u044F \u043C\u044B\u0448\u044C\u044E
      \u0438\u043B\u0438 \u043F\u0440\u0430\u0432\u044B\u043C \u0441\u0442\u0438\u043A\u043E\u043C.
      \u041B\u041A\u041C \u0438\u043B\u0438 RT \u2014 \u0431\u0440\u043E\u0441\u043E\u043A.
      \u041D\u0435\u0432\u0430\u043B\u044F\u0448\u043A\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170830
    m_Localized: "\u041F\u043E\u0434\u0431\u0435\u0440\u0438 \u043C\u044F\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170831
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u043C\u044F\u0447\u0443
      \u2014 \u043E\u043D \u0441\u0430\u043C \u043F\u0440\u044B\u0433\u043D\u0435\u0442
      \u0432 \u0440\u0443\u043A\u0438. \u041F\u041A\u041C / E / LT \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043C\u044F\u0447\u043E\u043C \u2014 \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u044C
      \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170832
    m_Localized: "\u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439 \u0431\u0440\u043E\u0441\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170833
    m_Localized: "\u0417\u0430\u0436\u043C\u0438 \u041B\u041A\u041C / RT, \u043F\u043E\u043A\u0430
      \u043F\u043E\u043B\u043E\u0441\u043A\u0430 \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u043D\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F,
      \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438: \u043C\u044F\u0447 \u043B\u0435\u0442\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0434\u0430\u043B\u044C\u0448\u0435
      \u0438 \u0431\u044C\u0451\u0442 \u0432\u0434\u0432\u043E\u0435 \u0441\u0438\u043B\u044C\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170834
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u0439 \u043C\u044F\u0447 \u0441\u043E\u043B\u0434\u0430\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170835
    m_Localized: "\u041C\u044F\u0447 \u043B\u0435\u0442\u0438\u0442 \u0432 \u0442\u0435\u0431\u044F
      \u0441\u043F\u0435\u0440\u0435\u0434\u0438 \u2014 \u0436\u043C\u0438 \u041F\u041A\u041C
      / E / LT. \u041D\u0430\u0436\u0430\u043B \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043C\u0438\u0433 \u2014 \u0437\u043E\u043B\u043E\u0442\u0430\u044F, \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F
      \u043B\u043E\u0432\u043B\u044F: \u043E\u043D\u0430 \u043B\u0435\u0447\u0438\u0442
      \u0441\u0435\u0440\u0434\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170836
    m_Localized: "\u0420\u044B\u0432\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170837
    m_Localized: "\u041F\u0440\u043E\u0431\u0435\u043B / Shift / A \u2014 \u0440\u044B\u0432\u043E\u043A.
      \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u044B\u0432\u043A\u0430
      \u043C\u044F\u0447\u0438 \u0438 \u0443\u0434\u0430\u0440\u044B \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
      \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170838
    m_Localized: "\u0412\u044B\u0431\u0435\u0439 \u0432\u0441\u0435\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170839
    m_Localized: "\u041B\u043E\u0432\u0438 \u043C\u044F\u0447\u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u0438\u043A\u043E\u0432
      \u2014 \u044D\u0442\u043E \u0437\u0430\u043F\u0430\u0441 \u043C\u044F\u0447\u0435\u0439
      \u0438 \u0441\u0435\u0440\u0434\u0435\u0446. \u041F\u0443\u043F\u0441\u044B
      \u0431\u044B\u0441\u0442\u0440\u044B\u0435, \u043D\u043E \u0438\u043C \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170840
    m_Localized: "\u042D\u043B\u0438\u0442\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170841
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u0430\u044F \u043C\u0435\u0442\u043A\u0430
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u2014 \u044D\u043B\u0438\u0442\u043D\u044B\u0439
      \u0432\u0440\u0430\u0433: \u043A\u0440\u0435\u043F\u0447\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
      \u0438 \u0441\u043E \u0441\u0432\u043E\u0438\u043C \u0444\u043E\u043A\u0443\u0441\u043E\u043C.
      \u0417\u043E\u043B\u043E\u0442\u0430\u044F \u043C\u0430\u0442\u0440\u0451\u0448\u043A\u0430
      \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432
      \u0434\u0432\u0435 \u043D\u0435\u0432\u0430\u043B\u044F\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170842
    m_Localized: "\u041F\u043E\u0440\u0442\u0444\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170843
    m_Localized: "\u0418\u0437 \u044D\u043B\u0438\u0442\u043A\u0438 \u0432\u044B\u043F\u0430\u043B
      \u043F\u043E\u0440\u0442\u0444\u0435\u043B\u044C \u2014 \u043F\u043E\u0434\u0431\u0435\u0440\u0438
      \u0435\u0433\u043E \u0438 \u0432\u044B\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443.
      \u041A\u0430\u0440\u0442\u043E\u0447\u043A\u0438 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442
      \u0442\u0435\u0431\u044F \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170844
    m_Localized: "\u041A\u0430\u0440\u043C\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170845
    m_Localized: "\u041A\u0430\u0440\u0442\u043E\u0447\u043A\u0430 \u043B\u0435\u0433\u043B\u0430
      \u0432 \u043A\u0430\u0440\u043C\u0430\u043D. Tab / Select \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u043A\u0430\u0440\u043C\u0430\u043D\u044B: \u0442\u0430\u043C \u0432\u0438\u0434\u043D\u043E,
      \u0447\u0442\u043E \u0434\u0430\u0451\u0442 \u043A\u0430\u0436\u0434\u0430\u044F.
      \u041A\u0430\u0440\u043C\u0430\u043D\u043E\u0432 \u0432\u0441\u0435\u0433\u043E
      \u0448\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170846
    m_Localized: "\u041B\u0430\u0440\u0451\u043A \xAB\u0421\u043E\u044E\u0437\u043F\u0435\u0447\u0430\u0442\u044C\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170847
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0430\u0440\u0435\u043D\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043B\u0430\u0440\u0451\u043A: \u043F\u043E\u0434\u043E\u0439\u0434\u0438
      \u0438 \u043D\u0430\u0436\u043C\u0438 F / X. \u041C\u043E\u043D\u0435\u0442\u043A\u0438
      \u043F\u0430\u0434\u0430\u044E\u0442 \u0441 \u0432\u0440\u0430\u0433\u043E\u0432
      \u2014 \u0432\u043E\u0442 \u0435\u0449\u0451 \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437. \u0422\u0430\u043C \u0436\u0432\u0430\u0447\u043A\u0438
      \u0441 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0430\u043C\u0438, \u043B\u0438\u043C\u043E\u043D\u0430\u0434
      \u0438 \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170848
    m_Localized: "\u0413\u041E\u0422\u041E\u0412 \u0413\u0423\u041B\u042F\u0422\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1455588411170849
    m_Localized: "\u041F\u0440\u043E\u0433\u0443\u043B\u043A\u0430 \u2014 \u044D\u0442\u043E
      \u0434\u0432\u043E\u0440, \u043A\u043E\u0440\u043E\u0431\u043A\u0430 \u0438\u043B\u0438
      \u0431\u0430\u0440\u0430\u0445\u043E\u043B\u043A\u0430, \u0441\u0442\u0440\u043E\u0439\u043A\u0430
      \u0438\u043B\u0438 \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u0441\u0430\u0434
      \u2014 \u0438 \u0434\u043E\u043C\u043E\u0439, \u043F\u043E\u043A\u0430 \u043C\u0430\u043C\u0430
      \u043D\u0435 \u043F\u043E\u0437\u0432\u0430\u043B\u0430. \u041F\u043E\u0441\u043B\u0435
      \u043A\u0430\u0436\u0434\u043E\u0439 \u0430\u0440\u0435\u043D\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043B\u0430\u0440\u0451\u043A. \u041F\u0440\u043E \u0432\u0441\u0435\u0445
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442
      \u0431\u0435\u0441\u0442\u0438\u0430\u0440\u0438\u0439 \u0432 \xAB\u0422\u0435\u0442\u0440\u0430\u0434\u043A\u0435\xBB."
    m_Metadata:
      m_Items: []
