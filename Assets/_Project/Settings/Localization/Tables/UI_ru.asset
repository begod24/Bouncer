  - m_Id: 1461472126296065
    m_Localized: "\u043D\u043E\u0432\u043E\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 1461472126296066
    m_Localized: "Q / E, LB / RB \u2014 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430   
      Esc / B \u2014 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1461472126296067
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1461472126296068
    m_Localized: "WASD / \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A
      \u2014 \u0431\u0435\u0433\n\u043C\u044B\u0448\u044C / \u043F\u0440\u0430\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u2014 \u043F\u0440\u0438\u0446\u0435\u043B\n\u041B\u041A\u041C
      / RT \u2014 \u0431\u0440\u043E\u0441\u043E\u043A, \u0434\u0435\u0440\u0436\u0438
      \u2014 \u0437\u0430\u0440\u044F\u0434\n\u041F\u041A\u041C / E / LT \u2014 \u043B\u043E\u0432\u043B\u044F
      \u0438\u043B\u0438 \u0445\u0432\u0430\u0442 \u043C\u044F\u0447\u0430 \u0440\u044F\u0434\u043E\u043C\n\u041F\u0440\u043E\u0431\u0435\u043B
      / Shift / A \u2014 \u0440\u044B\u0432\u043E\u043A\nQ / LB \u2014 \u0444\u043E\u043D\u0430\u0440\u0438\u043A
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435\nF / X \u2014 \u043B\u0430\u0440\u0451\u043A   
      Tab / Select \u2014 \u043A\u0430\u0440\u043C\u0430\u043D\u044B\nEsc / Start
      \u2014 \u043F\u0430\u0443\u0437\u0430    H \u2014 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
      \u0432 \u0438\u0433\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1461472126296069
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u0434\u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1461472126296070
    m_Localized: "\u0412\u044B\u0431\u0438\u0432\u0430\u0439 \u0438\u0433\u0440\u0443\u0448\u043A\u0438
      \u043C\u044F\u0447\u043E\u043C \u0438 \u043B\u043E\u0432\u0438 \u0438\u0445
      \u043C\u044F\u0447\u0438: \u043F\u043E\u0439\u043C\u0430\u043D\u043D\u044B\u0439
      \u043C\u044F\u0447 \u0442\u0432\u043E\u0439, \u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F
      \u043B\u043E\u0432\u043B\u044F \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043C\u0438\u0433 \u043B\u0435\u0447\u0438\u0442 \u0441\u0435\u0440\u0434\u0446\u0435.
      \u041A\u0440\u0430\u0441\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u044E\u0447\u0435\u0433\u043E
      \u0451\u0436\u0438\u043A\u0430 \u043D\u0435 \u043B\u043E\u0432\u0438 \u2014
      \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F.\n\n\u0421
      \u0432\u0440\u0430\u0433\u043E\u0432 \u043F\u0430\u0434\u0430\u044E\u0442 \u043C\u043E\u043D\u0435\u0442\u043A\u0438,
      \u0441 \u044D\u043B\u0438\u0442\u043E\u043A (\u0437\u043E\u043B\u043E\u0442\u0430\u044F
      \u043C\u0435\u0442\u043A\u0430) \u2014 \u043F\u043E\u0440\u0442\u0444\u0435\u043B\u044C
      \u0441 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0430\u043C\u0438. \u041A\u0430\u0440\u0442\u043E\u0447\u043A\u0438
      \u043B\u0435\u0436\u0430\u0442 \u0432 \u0448\u0435\u0441\u0442\u0438 \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u0445.\n\n\u041F\u043E\u0441\u043B\u0435
      \u0430\u0440\u0435\u043D\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043B\u0430\u0440\u0451\u043A \xAB\u0421\u043E\u044E\u0437\u043F\u0435\u0447\u0430\u0442\u044C\xBB,
      \u043F\u043E\u0442\u043E\u043C \u0441\u0442\u0440\u0435\u043B\u043A\u0430 \u0432\u0435\u0434\u0451\u0442
      \u0434\u0430\u043B\u044C\u0448\u0435 \u2014 \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435
      \u0432\u044B\u0431\u0438\u0440\u0430\u0439 \u043F\u0443\u0442\u044C. \u0412
      \u0444\u0438\u043D\u0430\u043B\u0435 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C,
      \u043F\u043E\u043A\u0430 \u043C\u0430\u043C\u0430 \u043D\u0435 \u043F\u043E\u0437\u043E\u0432\u0451\u0442,
      \u0438 \u0434\u043E\u0431\u0435\u0433\u0438 \u0434\u043E \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0430.
      \u041F\u043E\u0431\u0435\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1461472126296071
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
