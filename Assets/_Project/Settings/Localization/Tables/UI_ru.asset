      \u0434\u043E\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371201
    m_Localized: "\u0414\u043E\u043C\u043E\u0439 \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371202
    m_Localized: "\u0414\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371203
    m_Localized: "\u041C\u0415\u0428\u041E\u041A!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371204
    m_Localized: "\u041F\u043E\u043F\u0430\u0434\u0438 \u0432 \u043C\u0435\u0448\u043E\u043A
      \u0441\u0437\u0430\u0434\u0438 \u2014 \u043C\u044F\u0447\u0438 \u0432\u044B\u0441\u044B\u043F\u043B\u044E\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371205
    m_Localized: "\u0412\u041E\u0420\u041E\u041D\u042C\u0401!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371206
    m_Localized: "\u0422\u0435\u043D\u044C \u043D\u0430 \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0435
      \u2014 \u044D\u0442\u043E \u0432\u043E\u0440\u043E\u043D\u0430. \u0421\u0431\u0435\u0439
      \u0435\u0451 \u043C\u044F\u0447\u043E\u043C, \u043A\u043E\u0433\u0434\u0430
      \u0441\u043F\u0438\u043A\u0438\u0440\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371207
    m_Localized: "\u041A\u0410\u0420\u0423\u0421\u0415\u041B\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371208
    m_Localized: "\u041B\u043E\u0432\u0438 \u043C\u044F\u0447\u0438 \u2014 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F
      \u043B\u043E\u0432\u043B\u044F \u043B\u0435\u0447\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371209
    m_Localized: "\u0420\u0410\u0417, \u0414\u0412\u0410, \u0422\u0420\u0418, \u0427\u0415\u0422\u042B\u0420\u0415,
      \u041F\u042F\u0422\u042C..."
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371210
    m_Localized: "\u0421\u043F\u0440\u044F\u0447\u044C\u0441\u044F \u0437\u0430 \u0440\u0430\u043A\u0435\u0442\u043E\u0439,
      \u043B\u0430\u0440\u044C\u043A\u043E\u043C \u0438\u043B\u0438 \u043A\u0430\u0447\u0435\u043B\u044F\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371211
    m_Localized: "\u042F \u0418\u0414\u0423 \u0418\u0421\u041A\u0410\u0422\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371212
    m_Localized: "\u0413\u0410\u0421\u0418\u0422 \u0421\u0412\u0415\u0422!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371213
    m_Localized: "\u0418\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u043B\u0435\u0437\u0443\u0442
      \u0442\u0435\u043D\u0438: \u0442\u0432\u0451\u0440\u0434\u044B\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u0430 \u0437\u0430\u043C\u0430\u0445\u0438\u0432\u0430\u044E\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371214
    m_Localized: "\u041F\u0420\u042F\u0422\u041A\u0418!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371215
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0432\u044B\u0434\u0430\u044E\u0442
      \u0433\u043E\u0440\u044F\u0449\u0438\u0435 \u0433\u043B\u0430\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371216
    m_Localized: "\u041C\u0410\u041C\u0410 \u0417\u041E\u0412\u0401\u0422 \u0414\u041E\u041C\u041E\u0419!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371217
    m_Localized: "\u0411\u0435\u0433\u0438 \u043A \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0443
      \u2014 \u0432 \u0441\u0432\u0435\u0442 \u0438\u0437 \u0434\u0432\u0435\u0440\u0438
      \u043E\u043D \u043D\u0435 \u0441\u0443\u043D\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371218
    m_Localized: "\xAB\u0422\u043E\u0442, \u043A\u0442\u043E \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445\xBB
      \u0432\u044B\u0431\u0438\u0442. \u0411\u0435\u0433\u0438 \u0434\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371219
    m_Localized: "\u0434\u043E \u0437\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 377581592371220
    m_Localized: "\u0414\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 441339446550528
    m_Localized: "\u041A\u0422\u041E \u0412\u042B\u0425\u041E\u0414\u0418\u0422 \u0413\u0423\u041B\u042F\u0422\u042C?"
    m_Metadata:
      m_Items: []
  - m_Id: 441339446550529
    m_Localized: "\u2190/\u2192 \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C,
      Enter / A \u2014 \u0433\u0443\u043B\u044F\u0442\u044C, \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u2014 \u0441\u043F\u0440\u0430\u0432\u0430 \u0432\u0432\u0435\u0440\u0445\u0443,
      Esc / B \u2014 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 445157471150080
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883039338496
    m_Localized: "\u041A\u0430\u0440\u043C\u0430\u043D\u044B \u043F\u043E\u043B\u043D\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883047727106
    m_Localized: "\u041D\u0435 \u0431\u0440\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921409
    m_Localized: "\u041A\u043B\u0438\u043A \u0438\u043B\u0438 Enter \u2014 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C,
      \u0435\u0449\u0451 \u0440\u0430\u0437 \u2014 \u043F\u0440\u043E\u0434\u0430\u0442\u044C   
      1\u20136 \u2014 \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0432\u044B\u0431\u043E\u0440   
      Esc \u2014 \u043D\u0430\u0437\u0430\u0434\n\u0413\u0435\u0439\u043C\u043F\u0430\u0434:
      A \u2014 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C,
      B \u2014 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921410
    m_Localized: "\u041A\u0430\u0440\u043C\u0430\u043D\u044B {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921411
    m_Localized: "\u041A\u0430\u0440\u043C\u0430\u043D\u044B \u043F\u043E\u043B\u043D\u044B
      \u2014 \u043F\u0440\u043E\u0434\u0430\u0439 \u043E\u0434\u043D\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043A\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921412
    m_Localized: "\u0417\u041E\u041B\u041E\u0422\u0410\u042F \xB7 \u0422\u041E\u041B\u042C\u041A\u041E
      \u041E\u0414\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921413
    m_Localized: "\u0448\u0443\u0441\u0442\u0440\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921414
    m_Localized: "\u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921415
    m_Localized: "\u043B\u043E\u0432\u043A\u0430\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921416
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921417
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921418
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921419
    m_Localized: "+1 \u044D\u043B\u0438\u0442\u043A\u0430 \u043D\u0430 \u0430\u0440\u0435\u043D\u0443,
      \u0443 \u044D\u043B\u0438\u0442\u043E\u043A \u0432\u0441\u0435\u0433\u0434\u0430
      \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921420
    m_Localized: "+ \u0432\u0440\u0430\u0433\u0438 \u043D\u0430 10% \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0451\u0436\u0438\u043A\u043E\u0432 \u0431\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921421
    m_Localized: "+ \u043C\u043E\u043D\u0435\u0442\u043E\u043A \u043D\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u043C\u0435\u043D\u044C\u0448\u0435, \u043B\u0435\u0447\u0435\u043D\u0438\u0435
      \u0432 \u043B\u0430\u0440\u044C\u043A\u0435 \u0434\u043E\u0440\u043E\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921422
    m_Localized: "+ \u0431\u043E\u0441\u0441\u044B \u0436\u0438\u0432\u0443\u0447\u0435\u0435
      \u0438 \u0447\u0430\u0449\u0435 \u0444\u0438\u043D\u0442\u044F\u0442, \u043C\u0430\u043C\u0430
      \u0437\u043E\u0432\u0451\u0442 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921423
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0438 \u2014 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921424
    m_Localized: "\u0420\u0435\u043A\u043E\u0440\u0434 \u043D\u0430 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921425
    m_Localized: "\u041B\u0443\u0447\u0448\u0435\u0435 \u043D\u0430 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      {0}: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921426
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u0430 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921427
    m_Localized: "\u0420\u0415\u041A\u041E\u0420\u0414\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921428
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C {0} \u2014
      {1} \xB7 {2} \xB7 \u043A\u0430\u0440\u0442\u043E\u0447\u0435\u043A: {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921429
    m_Localized: "\u041F\u043E\u043A\u0430 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439
      \u043F\u043E\u0431\u0435\u0434\u044B. \u0414\u043E\u0432\u0435\u0434\u0438
      \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0443 \u0434\u043E \u0434\u043E\u043C\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921430
    m_Localized: "\u0420\u0435\u043A\u043E\u0440\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921431
    m_Localized: "\u0418\u0417 \u041C\u0415\u0428\u041A\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 1198883051921432
    m_Localized: "\u0422\u0451\u043C\u043D\u044B\u0435 \u043C\u044F\u0447\u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442
      \u2014 \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1280563745906688
    m_Localized: "\u0411\u0430\u0440\u0430\u0445\u043E\u043B\u043A\u0430 \xB7 \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1280563750100992
    m_Localized: "\u0414\u0435\u0442\u0441\u043A\u0438\u0439 \u0441\u0430\u0434 \xB7
      \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1280563750100993
    m_Localized: "\u041D\u0430 \u0431\u0430\u0440\u0430\u0445\u043E\u043B\u043A\u0443
      \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 1280563750100994
    m_Localized: "\u0412 \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u0441\u0430\u0434
